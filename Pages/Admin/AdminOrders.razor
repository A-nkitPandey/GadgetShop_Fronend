@page "/admin/orders"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Orders – Admin</PageTitle>

<MudText Typo="Typo.h5" Class="gs-page-title mb-4">Order Management</MudText>

<!-- FILTERS -->
<MudCard Elevation="0" Class="gs-admin-card mb-4">
    <MudCardContent Class="py-2">
        <MudGrid>
            <MudItem xs="12" sm="4" md="3">
                <MudSelect T="string" Value="_statusFilter" ValueChanged="OnStatusFilterChangedAsync" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                    @foreach (var s in AppConstants.OrderStatus.All)
                    {
                        <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudDateRangePicker @bind-DateRange="_dateRange" Label="Date Range" Variant="Variant.Outlined" Margin="Margin.Dense"
                                    />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<MudCard Elevation="0" Class="gs-admin-card">
    <MudTable T="OrderDto" Items="_orders" Loading="_loading" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh><AdminSortHeader Label="Order #" Column="OrderNo" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Customer" Column="CustomerName" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Date" Column="CreatedAt" Query="_query" OnSorted="LoadAsync" InitialDescending="true" /></MudTh>
            <MudTh><AdminSortHeader Label="Amount" Column="TotalAmount" Query="_query" OnSorted="LoadAsync" InitialDescending="true" /></MudTh>
            <MudTh><AdminSortHeader Label="Payment" Column="PaymentStatus" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Status" Column="Status" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudText Typo="Typo.body2" Class="fw-semibold">#@context.OrderNo</MudText></MudTd>
            <MudTd>@(context.CustomerName ?? "—")</MudTd>
            <MudTd>@context.CreatedAt.ToString("dd MMM yy")</MudTd>
            <MudTd>₹@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.PaymentStatus == "Paid" ? Color.Success : Color.Warning)">
                    @(context.PaymentStatus ?? "Pending")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Rounded.Visibility" Size="Size.Small" Color="Color.Primary"
                               Href="@($"/admin/orders/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" Color="Color.Secondary"
                               OnClick="@(() => OpenStatusDialogAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.ReceiptLong" Title="No orders" /></NoRecordsContent>
    </MudTable>
    <div class="px-4 py-2">
        <MudPagination Count="@_totalPages" Selected="_query.PageNo" SelectedChanged="OnPageChangedAsync" Color="Color.Primary" />
    </div>
</MudCard>

<!-- STATUS UPDATE DIALOG -->
@if (_showStatusDialog && _selectedOrder != null)
{
    <MudOverlay Visible="_showStatusDialog" DarkBackground="true" ZIndex="200"><div class="gs-modal-wrap">
        <div class="gs-modal-header"><MudText Typo="Typo.h6">Update Order #@_selectedOrder.OrderNo</MudText></div>
        <div class="gs-modal-body">
            <MudSelect T="string" @bind-Value="_newStatus" Label="New Status" Variant="Variant.Outlined">
                @foreach (var s in AppConstants.OrderStatus.All)
                {
                    <MudSelectItem Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_statusRemarks" Label="Remarks" Variant="Variant.Outlined" Class="mt-3" />
        </div>
        <div class="gs-modal-actions">
            <MudButton OnClick="@(() => _showStatusDialog = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateStatusAsync" Disabled="_updatingStatus">Update</MudButton>
        </div>
    </div></MudOverlay>
}

@code {
    private bool _loading = true, _showStatusDialog, _updatingStatus;
    private string _statusFilter = string.Empty;
    private int _totalPages = 1;
    private OrderListRequest _query = new() { PageSize = 20, SortByColumn = "CreatedAt", SortDesOrder = true };
    private List<OrderDto> _orders = new();
    private OrderDto? _selectedOrder;
    private string _newStatus = string.Empty;
    private string _statusRemarks = string.Empty;
    private DateRange? _dateRange;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _query.OrderStatus = string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter;
        var res = await OrderService.GetOrderListAsync(_query);
        if (res.IsSuccess && res.Data != null) { _orders = res.Data.Items; _totalPages = res.Data.TotalPages; }
        _loading = false;
    }

    private async Task OnPageChangedAsync(int page)
    {
        _query.PageNo = page;
        await LoadAsync();
    }

    private async Task OnStatusFilterChangedAsync(string value)
    {
        _statusFilter = value;
        _query.PageNo = 1;
        await LoadAsync();
    }

    private void OpenStatusDialogAsync(OrderDto o)
    {
        _selectedOrder = o;
        _newStatus = o.Status ?? string.Empty;
        _statusRemarks = string.Empty;
        _showStatusDialog = true;
    }

    private async Task UpdateStatusAsync()
    {
        _updatingStatus = true;
        var res = await OrderService.UpdateOrderStatusAsync(new UpdateOrderStatusRequest
        {
            Id = _selectedOrder!.Id,
            OrderStatus = _newStatus,
            Remarks = _statusRemarks
        });
        if (res.IsSuccess)
        {
            Snackbar.Add("Status updated!", Severity.Success);
            _showStatusDialog = false;
            await LoadAsync();
        }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error", Severity.Error);
        _updatingStatus = false;
    }

    private Color GetStatusColor(string? s) => s switch
    {
        "Delivered" => Color.Success, "Shipped" => Color.Info,
        "Cancelled" => Color.Error, "Confirmed" => Color.Primary, _ => Color.Warning
    };
}
