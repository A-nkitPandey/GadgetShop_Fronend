@page "/admin/invoices/{InvoiceId:long}/print"
@layout GadgetShop.Layout.PrintLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminCatalogAdminService AdminService
@inject IJSRuntime JSRuntime

<PageTitle>Invoice Print - Admin</PageTitle>

@if (_loading)
{
    <MudSkeleton Height="500px" Class="rounded-xl" />
}
else if (_invoice == null)
{
    <EmptyState Icon="@Icons.Material.Rounded.ReceiptLong" Title="Invoice print view unavailable" ActionHref="/admin/invoices" ActionLabel="Back to Invoices" />
}
else
{
    <div class="d-flex justify-space-between align-center mb-4 gs-no-print">
        <MudText Typo="Typo.h4" Class="gs-page-title">Print Invoice #@_invoice.InvoiceNo</MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/admin/invoices/{InvoiceId}")">
                Back to Invoice
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Print" OnClick="PrintAsync">
                Print
            </MudButton>
        </div>
    </div>

    <MudPaper Class="pa-4 gs-print-document">
        @((MarkupString)_invoice.HtmlContent)
    </MudPaper>
}

@code {
    [Parameter] public long InvoiceId { get; set; }

    private bool _loading = true;
    private InvoicePrintDocumentDto? _invoice;

    protected override async Task OnInitializedAsync()
    {
        var response = await AdminService.GetInvoicePrintDocumentAsync(new InvoicePrintDocumentRequest { Id = InvoiceId });
        _invoice = response.Data;
        _loading = false;
    }

    private Task PrintAsync() => JSRuntime.InvokeVoidAsync("print").AsTask();
}
