@page "/admin/coupons"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminProductService ProductService
@inject ISnackbar Snackbar

<PageTitle>Coupons – Admin</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5" Class="gs-page-title">Coupon Management</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add"
               OnClick="@(() => OpenFormAsync(null))">Add Coupon</MudButton>
</div>

<MudCard Elevation="0" Class="gs-admin-card">
    <MudTable T="CouponDto" Items="_coupons" Loading="_loading" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Type</MudTh><MudTh>Value</MudTh>
            <MudTh>Valid From</MudTh><MudTh>Valid To</MudTh><MudTh>Status</MudTh><MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.CouponCode</MudChip></MudTd>
            <MudTd>@context.CouponName</MudTd>
            <MudTd>@context.DiscountType</MudTd>
            <MudTd>@(context.DiscountType == "Percentage" ? context.DiscountValue + "%" : "₹" + context.DiscountValue)</MudTd>
            <MudTd>@context.ValidFrom.ToString("dd MMM yy")</MudTd>
            <MudTd>@context.ValidTo.ToString("dd MMM yy")</MudTd>
            <MudTd>
                <MudSwitch T="bool" Value="context.IsActive" Color="Color.Primary"
                           ValueChanged="@(v => ToggleStatusAsync(context, v))" />
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenFormAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.LocalOffer" Title="No coupons" /></NoRecordsContent>
    </MudTable>
    <div class="px-4 py-2">
        <MudPagination Count="@_totalPages" Selected="_page" SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" Color="Color.Primary" />
    </div>
</MudCard>

@if (_showForm)
{
    <MudOverlay Visible="_showForm" DarkBackground="true" ZIndex="200"><div class="gs-modal-wrap">
        <div class="gs-modal-header"><MudText Typo="Typo.h6">@(_editId == null ? "Add" : "Edit") Coupon</MudText></div>
        <div class="gs-modal-body">
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.CouponCode" Label="Code *" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.CouponName" Label="Name *" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_form.DiscountType" Label="Discount Type" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Percentage")">Percentage (%)</MudSelectItem>
                        <MudSelectItem Value="@("Flat")">Flat (₹)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal" @bind-Value="_form.DiscountValue" Label="Value *" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal?" @bind-Value="_form.MinimumOrderAmount" Label="Min Order Amt" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="decimal?" @bind-Value="_form.MaximumDiscountAmount" Label="Max Discount" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_validFrom" Label="Valid From" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_validTo" Label="Valid To" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_form.Description" Label="Description" Lines="2" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <ApiErrorAlert Errors="_formErrors" />
        </div>
        <div class="gs-modal-actions">
            <MudButton OnClick="@(() => _showForm = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">Save</MudButton>
        </div>
    </div></MudOverlay>
}

@code {
    private bool _loading = true, _showForm, _saving;
    private long? _editId;
    private int _page = 1, _totalPages = 1;
    private List<CouponDto> _coupons = new();
    private CreateCouponRequest _form = new();
    private DateTime? _validFrom = DateTime.Today;
    private DateTime? _validTo = DateTime.Today.AddMonths(1);
    private List<string>? _formErrors;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var res = await ProductService.GetCouponListAsync(new PaginationRequest { PageNo = _page, PageSize = 20 });
        if (res.IsSuccess && res.Data != null) { _coupons = res.Data.Items; _totalPages = res.Data.TotalPages; }
        _loading = false;
    }

    private void OpenFormAsync(CouponDto? c)
    {
        _editId = c?.Id;
        _form = c == null ? new() { DiscountType = "Percentage" }
            : new() { CouponCode = c.CouponCode ?? "", CouponName = c.CouponName ?? "", DiscountType = c.DiscountType ?? "Percentage", DiscountValue = c.DiscountValue, ValidFrom = c.ValidFrom, ValidTo = c.ValidTo };
        _validFrom = _form.ValidFrom;
        _validTo = _form.ValidTo;
        _formErrors = null; _showForm = true;
    }

    private async Task SaveAsync()
    {
        _saving = true; _formErrors = null;
        _form.ValidFrom = _validFrom ?? DateTime.Today;
        _form.ValidTo = _validTo ?? DateTime.Today.AddMonths(1);
        var res = _editId == null
            ? await ProductService.CreateCouponAsync(_form)
            : await ProductService.UpdateCouponAsync(new UpdateCouponRequest { Id = _editId.Value, CouponCode = _form.CouponCode, CouponName = _form.CouponName, DiscountType = _form.DiscountType, DiscountValue = _form.DiscountValue, ValidFrom = _form.ValidFrom, ValidTo = _form.ValidTo, Description = _form.Description, MinimumOrderAmount = _form.MinimumOrderAmount, MaximumDiscountAmount = _form.MaximumDiscountAmount });
        if (res.IsSuccess) { Snackbar.Add("Saved!", Severity.Success); _showForm = false; await LoadAsync(); }
        else _formErrors = res.Errors;
        _saving = false;
    }

    private async Task ToggleStatusAsync(CouponDto c, bool v)
    {
        var r = await ProductService.UpdateCouponStatusAsync(new CouponStatusUpdateRequest { Id = c.Id, IsActive = v });
        if (r.IsSuccess) { c.IsActive = v; Snackbar.Add("Updated", Severity.Success); }
    }
}
