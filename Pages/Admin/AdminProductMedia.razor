@page "/admin/products/{ProductId:long}/media"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminProductService ProductService
@inject ISnackbar Snackbar

<PageTitle>Product Media - Admin</PageTitle>

<div class="gs-admin-toolbar mb-4">
    <div class="gs-admin-toolbar-actions">
    <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Href="/admin/products" />
    <MudText Typo="Typo.h5" Class="gs-page-title">Product Media</MudText>
    <MudChip T="string" Color="Color.Primary">Product ID: @ProductId</MudChip>
    </div>
</div>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudCard Elevation="0" Class="gs-admin-card mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Primary Image</MudText>
                @if (!string.IsNullOrWhiteSpace(_primaryPreviewUrl))
                {
                    <img src="@_primaryPreviewUrl" alt="primary" class="gs-admin-media-preview" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No primary image available.</MudAlert>
                }
                <div class="mt-3">
                    <InputFile OnChange="OnPrimarySelected" accept=".png,.jpg,.jpeg,.webp" />
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                           Disabled="_uploadingPrimary || _primaryFile == null" OnClick="UploadPrimaryAsync">
                    @if (_uploadingPrimary) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Upload Primary Image
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="0" Class="gs-admin-card">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Add Gallery Images</MudText>
                @if (_galleryPreviews.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-3 mb-3">
                        @foreach (var preview in _galleryPreviews)
                        {
                            <img src="@preview" alt="preview" style="width:100px;height:100px;object-fit:cover;border-radius:12px" />
                        }
                    </div>
                }
                <InputFile OnChange="OnGallerySelected" Multiple="true" accept=".png,.jpg,.jpeg,.webp" />
                <MudCheckBox T="bool" @bind-Value="_newGalleryPrimary" Label="Mark first uploaded image as primary" Class="mt-2" />
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3"
                           Disabled="_uploadingGallery || _galleryFiles.Count == 0" OnClick="UploadGalleryAsync">
                    @if (_uploadingGallery) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Upload Gallery Images
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="7">
        <MudCard Elevation="0" Class="gs-admin-card">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Gallery</MudText>
                @if (_loading)
                {
                    <MudSkeleton Height="260px" Class="rounded-xl" />
                }
                else if (_gallery.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Rounded.Collections" Title="No gallery images yet" />
                }
                else
                {
                    <div class="gs-admin-gallery-grid">
                        @foreach (var image in _gallery.OrderBy(x => x.DisplayOrder))
                        {
                                <MudPaper Class="pa-3" Outlined="true">
                                    <img src="@image.ImageUrl" alt="gallery" style="width:100%;height:180px;object-fit:cover;border-radius:14px" />
                                    <div class="gs-admin-inline-meta mt-3">
                                        <MudText Typo="Typo.caption">Display Order: @image.DisplayOrder</MudText>
                                        @if (image.IsPrimary)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Primary</MudChip>
                                        }
                                    </div>
                                    <div class="gs-admin-toolbar-actions mt-3">
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="image.IsPrimary" OnClick="@(() => SetPrimaryAsync(image))">
                                            Set Primary
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteAsync(image))">
                                            Delete
                                        </MudButton>
                                    </div>
                                </MudPaper>
                        }
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public long ProductId { get; set; }

    private bool _loading = true;
    private bool _uploadingPrimary;
    private bool _uploadingGallery;
    private bool _newGalleryPrimary;
    private IBrowserFile? _primaryFile;
    private string? _primaryPreviewUrl;
    private List<IBrowserFile> _galleryFiles = new();
    private List<string> _galleryPreviews = new();
    private List<ProductGalleryImageDto> _gallery = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var response = await ProductService.GetProductGalleryAsync(new ProductGalleryGetByProductIdRequest { ProductId = ProductId });
        if (response.IsSuccess && response.Data != null)
        {
            _gallery = response.Data;
            _primaryPreviewUrl = _gallery.FirstOrDefault(x => x.IsPrimary)?.ImageUrl ?? _gallery.FirstOrDefault()?.ImageUrl;
        }
        else
        {
            Snackbar.Add(response.Errors.FirstOrDefault() ?? "Unable to load product gallery.", Severity.Error);
        }
        _loading = false;
    }

    private async Task OnPrimarySelected(InputFileChangeEventArgs args)
    {
        _primaryFile = args.File;
        if (_primaryFile == null || !ValidateImageFile(_primaryFile))
        {
            _primaryFile = null;
            return;
        }
        _primaryPreviewUrl = await BuildPreviewAsync(_primaryFile);
    }

    private async Task OnGallerySelected(InputFileChangeEventArgs args)
    {
        _galleryFiles = args.GetMultipleFiles(8).Where(ValidateImageFile).ToList();
        _galleryPreviews.Clear();
        foreach (var file in _galleryFiles)
            _galleryPreviews.Add(await BuildPreviewAsync(file));
    }

    private async Task UploadPrimaryAsync()
    {
        if (_primaryFile == null)
            return;

        _uploadingPrimary = true;
        var response = await ProductService.UploadProductImageAsync(await BuildPrimaryRequestAsync(_primaryFile));
        if (response.IsSuccess && response.Data != null)
        {
            Snackbar.Add(response.Data.Message, Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(response.Errors.FirstOrDefault() ?? "Primary image upload failed.", Severity.Error);
        }
        _uploadingPrimary = false;
    }

    private async Task UploadGalleryAsync()
    {
        _uploadingGallery = true;
        var displayOrder = _gallery.Count == 0 ? 0 : _gallery.Max(x => x.DisplayOrder) + 1;

        for (var index = 0; index < _galleryFiles.Count; index++)
        {
            var file = _galleryFiles[index];
            var bytes = await ReadBytesAsync(file);
            var response = await ProductService.UploadProductGalleryImageAsync(new ProductGalleryImageUploadRequest
            {
                ProductId = ProductId,
                DisplayOrder = displayOrder + index,
                IsPrimary = _newGalleryPrimary && index == 0,
                ImageContent = bytes,
                FileName = file.Name,
                ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType
            });

            if (!response.IsSuccess)
            {
                Snackbar.Add(response.Errors.FirstOrDefault() ?? $"Failed to upload {file.Name}.", Severity.Error);
            }
        }

        _galleryFiles.Clear();
        _galleryPreviews.Clear();
        _newGalleryPrimary = false;
        _uploadingGallery = false;
        await LoadAsync();
    }

    private async Task SetPrimaryAsync(ProductGalleryImageDto image)
    {
        var response = await ProductService.SetPrimaryProductGalleryImageAsync(new ProductPrimaryImageUpdateRequest
        {
            ProductId = ProductId,
            ProductImageId = image.Id
        });

        if (response.IsSuccess)
        {
            Snackbar.Add("Primary image updated.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(response.Errors.FirstOrDefault() ?? "Unable to update primary image.", Severity.Error);
        }
    }

    private async Task DeleteAsync(ProductGalleryImageDto image)
    {
        var response = await ProductService.DeleteProductGalleryImageAsync(new ProductGalleryImageDeleteRequest
        {
            ProductId = ProductId,
            ProductImageId = image.Id
        });

        if (response.IsSuccess)
        {
            Snackbar.Add("Gallery image deleted.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(response.Errors.FirstOrDefault() ?? "Unable to delete image.", Severity.Error);
        }
    }

    private async Task<ProductImageUploadRequest> BuildPrimaryRequestAsync(IBrowserFile file) =>
        new()
        {
            ProductId = ProductId,
            ImageContent = await ReadBytesAsync(file),
            FileName = file.Name,
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType
        };

    private static async Task<byte[]> ReadBytesAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        return memory.ToArray();
    }

    private static async Task<string> BuildPreviewAsync(IBrowserFile file)
    {
        var bytes = await ReadBytesAsync(file);
        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        return $"data:{contentType};base64,{Convert.ToBase64String(bytes)}";
    }

    private bool ValidateImageFile(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed = new[] { ".png", ".jpg", ".jpeg", ".webp" };
        if (!allowed.Contains(extension))
        {
            Snackbar.Add($"{file.Name}: only PNG, JPG, JPEG, and WEBP images are allowed.", Severity.Warning);
            return false;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            Snackbar.Add($"{file.Name}: image size must be under 5 MB.", Severity.Warning);
            return false;
        }

        return true;
    }
}
