@page "/admin/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminDashboardService DashboardService

<PageTitle>Dashboard - GadgetShop Admin</PageTitle>

<MudText Typo="Typo.h4" Class="gs-page-title mb-2">Dashboard</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Welcome back! Here's what's happening today.
</MudText>

@if (_loading)
{
    <MudGrid>
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton Height="120px" Class="rounded-xl" />
            </MudItem>
        }
    </MudGrid>
}
else if (_summary != null)
{
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="4" lg="2">
            <DashboardKpiCard Title="Total Orders" Value="@_summary.TotalOrders.ToString("N0")"
                              Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <DashboardKpiCard Title="Revenue" Value="@("₹" + _summary.TotalRevenue.ToString("N0"))"
                              Icon="@Icons.Material.Rounded.CurrencyRupee" Color="Color.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <DashboardKpiCard Title="Products" Value="@_summary.TotalProducts.ToString("N0")"
                              Icon="@Icons.Material.Rounded.Inventory2" Color="Color.Info" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <DashboardKpiCard Title="Pending Orders" Value="@_summary.PendingOrders.ToString()"
                              Icon="@Icons.Material.Rounded.HourglassTop" Color="Color.Warning" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <DashboardKpiCard Title="Low Stock" Value="@_summary.LowStockProducts.ToString()"
                              Icon="@Icons.Material.Rounded.Warning" Color="Color.Error" />
        </MudItem>
    </MudGrid>
}

@if (_overview != null)
{
    <MudGrid Class="mb-6">
        <MudItem xs="12" md="5">
            <MudCard Elevation="0" Class="gs-admin-card h-100">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">Top Products</MudText>
                    @if (_overview.TopProducts.Count == 0)
                    {
                        <EmptyState Icon="@Icons.Material.Rounded.Inventory2" Title="No data" />
                    }
                    else
                    {
                        @foreach (var (product, i) in _overview.TopProducts.Select((product, index) => (product, index + 1)))
                        {
                            <div class="d-flex align-center gap-2 py-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@i</MudAvatar>
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body2" Class="fw-semibold">@product.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@product.SoldQty units · ₹@product.Revenue.ToString("N0")</MudText>
                                </div>
                            </div>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudCard Elevation="0" Class="gs-admin-card h-100">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.h6" Class="fw-bold">Recent Orders</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/admin/orders"
                                   EndIcon="@Icons.Material.Rounded.ArrowForward">View All</MudButton>
                    </div>
                    <MudTable T="RecentOrderDto" Items="_overview.RecentOrders" Elevation="0" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Order #</MudTh>
                            <MudTh>Customer</MudTh>
                            <MudTh>Amount</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Date</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Order">#@context.OrderNo</MudTd>
                            <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                            <MudTd DataLabel="Amount">₹@context.Amount.ToString("N0")</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private AdminDashboardSummaryDto? _summary;
    private AdminDashboardOverviewDto? _overview;

    protected override async Task OnInitializedAsync()
    {
        var summaryTask = DashboardService.GetSummaryAsync();
        var overviewTask = DashboardService.GetOverviewAsync();
        _summary = (await summaryTask).Data;
        _overview = (await overviewTask).Data;
        _loading = false;
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "Delivered" => Color.Success,
        "Shipped" => Color.Info,
        "Cancelled" => Color.Error,
        "Confirmed" => Color.Primary,
        _ => Color.Warning
    };
}
