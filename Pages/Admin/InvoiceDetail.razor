@page "/admin/invoices/{InvoiceId:long}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminCatalogAdminService AdminService

<PageTitle>Invoice Detail - Admin</PageTitle>

@if (_loading)
{
    <MudSkeleton Height="360px" Class="rounded-xl" />
}
else if (_invoice == null)
{
    <EmptyState Icon="@Icons.Material.Rounded.ReceiptLong" Title="Invoice not found" ActionHref="/admin/invoices" ActionLabel="Back to Invoices" />
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4" Class="gs-page-title">Invoice #@_invoice.InvoiceNo</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/admin/invoices/{InvoiceId}/print")" StartIcon="@Icons.Material.Rounded.Print">
            Print View
        </MudButton>
    </div>

    <MudCard Elevation="0" Class="gs-admin-card">
        <MudCardContent>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Order</MudText><MudText Typo="Typo.body2">@_invoice.OrderNo</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Customer</MudText><MudText Typo="Typo.body2">@_invoice.CustomerName</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Taxable Amount</MudText><MudText Typo="Typo.body2">Rs @_invoice.TaxableAmount.ToString("N2")</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Tax</MudText><MudText Typo="Typo.body2">Rs @_invoice.TaxAmount.ToString("N2")</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Discount</MudText><MudText Typo="Typo.body2">Rs @_invoice.DiscountAmount.ToString("N2")</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Grand Total</MudText><MudText Typo="Typo.body2">Rs @_invoice.GrandTotal.ToString("N2")</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Generated By</MudText><MudText Typo="Typo.body2">@_invoice.GeneratedBy</MudText></div>
            <div class="gs-summary-row"><MudText Typo="Typo.body2">Generated At</MudText><MudText Typo="Typo.body2">@_invoice.GeneratedAt.ToString("dd MMM yyyy, hh:mm tt")</MudText></div>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public long InvoiceId { get; set; }

    private bool _loading = true;
    private InvoiceAdminDetailDto? _invoice;

    protected override async Task OnInitializedAsync()
    {
        var response = await AdminService.GetInvoiceByIdAsync(new InvoiceGetByIdRequest { Id = InvoiceId });
        _invoice = response.Data;
        _loading = false;
    }
}
