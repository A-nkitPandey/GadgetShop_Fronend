@page "/admin/payments"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminCatalogAdminService AdminService
@inject ISnackbar Snackbar

<PageTitle>Payments - Admin</PageTitle>

<MudText Typo="Typo.h5" Class="gs-page-title mb-4">Payment Management</MudText>

<MudCard Elevation="0" Class="gs-admin-card">
    <MudTable T="PaymentAdminDto" Items="_payments" Loading="_loading" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh><AdminSortHeader Label="Payment #" Column="PaymentNo" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Order #" Column="OrderNo" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Customer" Column="CustomerName" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Amount" Column="Amount" Query="_query" OnSorted="LoadAsync" InitialDescending="true" /></MudTh>
            <MudTh><AdminSortHeader Label="Gateway" Column="GatewayName" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Status" Column="PaymentStatus" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Date" Column="PaymentDate" Query="_query" OnSorted="LoadAsync" InitialDescending="true" /></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.PaymentNo</MudTd>
            <MudTd>@context.OrderNo</MudTd>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>₹@context.Amount.ToString("N0")</MudTd>
            <MudTd>@context.GatewayName</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.PaymentStatus == "Paid" ? Color.Success : Color.Warning)">
                    @(context.PaymentStatus ?? "Pending")
                </MudChip>
            </MudTd>
            <MudTd>@context.PaymentDate?.ToString("dd MMM yy HH:mm")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="@(() => OpenRefundDialogAsync(context))">Refund</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.Payment" Title="No payments" /></NoRecordsContent>
    </MudTable>
    <div class="px-4 py-2">
        <MudPagination Count="@_totalPages" Selected="_query.PageNo" SelectedChanged="OnPageChangedAsync" Color="Color.Primary" />
    </div>
</MudCard>

@if (_showRefund)
{
    <MudOverlay Visible="_showRefund" DarkBackground="true" ZIndex="200"><div class="gs-modal-wrap">
        <div class="gs-modal-header"><MudText Typo="Typo.h6">Process Refund</MudText></div>
        <div class="gs-modal-body">
            <MudNumericField T="decimal" @bind-Value="_refundRequest.RefundAmount" Label="Refund Amount *"
                             Adornment="Adornment.Start" AdornmentText="₹" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_refundRequest.Reason" Label="Reason" Variant="Variant.Outlined" />
        </div>
        <div class="gs-modal-actions">
            <MudButton OnClick="@(() => _showRefund = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ProcessRefundAsync" Disabled="_processing">Refund</MudButton>
        </div>
    </div></MudOverlay>
}

@code {
    private bool _loading = true;
    private bool _showRefund;
    private bool _processing;
    private int _totalPages = 1;
    private PaginationRequest _query = new() { PageSize = 20, SortByColumn = "PaymentDate", SortDesOrder = true };
    private List<PaymentAdminDto> _payments = new();
    private ProcessPaymentRefundRequest _refundRequest = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var res = await AdminService.GetPaymentListAsync(_query);
        if (res.IsSuccess && res.Data != null)
        {
            _payments = res.Data.Items;
            _totalPages = res.Data.TotalPages;
        }
        _loading = false;
    }

    private async Task OnPageChangedAsync(int page)
    {
        _query.PageNo = page;
        await LoadAsync();
    }

    private void OpenRefundDialogAsync(PaymentAdminDto payment)
    {
        _refundRequest = new ProcessPaymentRefundRequest { PaymentId = payment.Id };
        _showRefund = true;
    }

    private async Task ProcessRefundAsync()
    {
        _processing = true;
        var res = await AdminService.ProcessRefundAsync(_refundRequest);
        if (res.IsSuccess)
        {
            Snackbar.Add("Refund processed!", Severity.Success);
            _showRefund = false;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error", Severity.Error);
        }
        _processing = false;
    }
}
