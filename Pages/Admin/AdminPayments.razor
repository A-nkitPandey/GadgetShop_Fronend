@* ──────────────────────────────────────────────────────────── *@
@* Admin Payments                                              *@
@* ──────────────────────────────────────────────────────────── *@
@page "/admin/payments"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminCatalogAdminService AdminService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Payments – Admin</PageTitle>

<MudText Typo="Typo.h5" Class="gs-page-title mb-4">Payment Management</MudText>

<MudCard Elevation="0" Class="gs-admin-card">
    <MudTable T="object" Items="_payments" Loading="_loading" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh>Payment ID</MudTh><MudTh>Order #</MudTh><MudTh>Amount</MudTh>
            <MudTh>Gateway</MudTh><MudTh>Status</MudTh><MudTh>Date</MudTh><MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@(GetProp(context, "Id"))</MudTd>
            <MudTd>@(GetProp(context, "OrderNo"))</MudTd>
            <MudTd>₹@(GetProp(context, "Amount"))</MudTd>
            <MudTd>@(GetProp(context, "GatewayName"))</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(GetProp(context,"Status")=="Paid" ? Color.Success : Color.Warning)">
                    @(GetProp(context, "Status") ?? "Pending")
                </MudChip>
            </MudTd>
            <MudTd>@(GetProp(context, "CreatedAt"))</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="@(() => OpenRefundDialogAsync(context))">Refund</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><EmptyState Icon="@Icons.Material.Rounded.Payment" Title="No payments" /></NoRecordsContent>
    </MudTable>
    <div class="px-4 py-2">
        <MudPagination Count="@_totalPages" Selected="_page" SelectedChanged="@(async p => { _page = p; await LoadAsync(); })" Color="Color.Primary" />
    </div>
</MudCard>

@if (_showRefund)
{
    <MudOverlay Visible="_showRefund" DarkBackground="true" ZIndex="200"><div class="gs-modal-wrap">
        <div class="gs-modal-header"><MudText Typo="Typo.h6">Process Refund</MudText></div>
        <div class="gs-modal-body">
            <MudNumericField T="decimal" @bind-Value="_refundRequest.RefundAmount" Label="Refund Amount *"
                             Adornment="Adornment.Start" AdornmentText="₹" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_refundRequest.Reason" Label="Reason" Variant="Variant.Outlined" />
        </div>
        <div class="gs-modal-actions">
            <MudButton OnClick="@(() => _showRefund = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ProcessRefundAsync" Disabled="_processing">Refund</MudButton>
        </div>
    </div></MudOverlay>
}

@code {
    private bool _loading = true, _showRefund, _processing;
    private int _page = 1, _totalPages = 1;
    private List<object> _payments = new();
    private ProcessPaymentRefundRequest _refundRequest = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var res = await AdminService.GetPaymentListAsync(new PaginationRequest { PageNo = _page, PageSize = 20 });
        if (res.IsSuccess && res.Data != null) { _payments = res.Data.Items; _totalPages = res.Data.TotalPages; }
        _loading = false;
    }

    private void OpenRefundDialogAsync(object payment)
    {
        var id = long.TryParse(GetProp(payment, "Id"), out var v) ? v : 0;
        _refundRequest = new ProcessPaymentRefundRequest { PaymentId = id };
        _showRefund = true;
    }

    private async Task ProcessRefundAsync()
    {
        _processing = true;
        var res = await AdminService.ProcessRefundAsync(_refundRequest);
        if (res.IsSuccess) { Snackbar.Add("Refund processed!", Severity.Success); _showRefund = false; await LoadAsync(); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error", Severity.Error);
        _processing = false;
    }

    private string? GetProp(object obj, string prop) =>
        obj?.GetType().GetProperty(prop)?.GetValue(obj)?.ToString();
}
