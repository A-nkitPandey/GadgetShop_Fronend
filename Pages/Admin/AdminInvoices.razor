@page "/admin/invoices"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject AdminCatalogAdminService AdminService
@inject ISnackbar Snackbar

<PageTitle>Invoices - Admin</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5" Class="gs-page-title">Invoice Management</MudText>
    <div class="d-flex gap-2 align-center">
        <MudNumericField T="long" @bind-Value="_genOrderId" Label="Order ID" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Style="width:140px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Rounded.Description"
                   OnClick="GenerateInvoiceAsync" Disabled="_generating">
            Generate
        </MudButton>
    </div>
</div>

<MudCard Elevation="0" Class="gs-admin-card">
    <MudTable T="InvoiceAdminDto" Items="_invoices" Loading="_loading" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh><AdminSortHeader Label="Invoice #" Column="InvoiceNo" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Order #" Column="OrderNo" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Customer" Column="CustomerName" Query="_query" OnSorted="LoadAsync" /></MudTh>
            <MudTh><AdminSortHeader Label="Amount" Column="GrandTotal" Query="_query" OnSorted="LoadAsync" InitialDescending="true" /></MudTh>
            <MudTh><AdminSortHeader Label="Date" Column="GeneratedAt" Query="_query" OnSorted="LoadAsync" InitialDescending="true" /></MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.InvoiceNo</MudTd>
            <MudTd>@context.OrderNo</MudTd>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>Rs @context.GrandTotal.ToString("N0")</MudTd>
            <MudTd>@context.GeneratedAt.ToString("dd MMM yy HH:mm")</MudTd>
            <MudTd>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/admin/invoices/{context.Id}")">Details</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Info" Href="@($"/admin/invoices/{context.Id}/print")">Print</MudButton>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Rounded.Description" Title="No invoices" />
        </NoRecordsContent>
    </MudTable>
    <div class="px-4 py-2">
        <MudPagination Count="@_totalPages" Selected="_query.PageNo" SelectedChanged="OnPageChangedAsync" Color="Color.Primary" />
    </div>
</MudCard>

@code {
    private bool _loading = true;
    private bool _generating;
    private long _genOrderId;
    private int _totalPages = 1;
    private PaginationRequest _query = new() { PageSize = 20, SortByColumn = "GeneratedAt", SortDesOrder = true };
    private List<InvoiceAdminDto> _invoices = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var res = await AdminService.GetInvoiceListAsync(_query);
        if (res.IsSuccess && res.Data != null)
        {
            _invoices = res.Data.Items;
            _totalPages = res.Data.TotalPages;
        }
        _loading = false;
    }

    private async Task OnPageChangedAsync(int page)
    {
        _query.PageNo = page;
        await LoadAsync();
    }

    private async Task GenerateInvoiceAsync()
    {
        if (_genOrderId <= 0)
        {
            Snackbar.Add("Enter a valid Order ID", Severity.Warning);
            return;
        }

        _generating = true;
        var res = await AdminService.GenerateInvoiceAsync(new GenerateInvoiceRequest { OrderId = _genOrderId });
        if (res.IsSuccess)
        {
            Snackbar.Add("Invoice generated!", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error", Severity.Error);
        }
        _generating = false;
    }
}
