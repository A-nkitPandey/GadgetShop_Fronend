@page "/forgot-password"
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Forgot Password – GadgetShop</PageTitle>

<div class="gs-auth-page">
    <div class="gs-auth-card">
        <div class="gs-auth-logo">
            <MudIcon Icon="@Icons.Material.Rounded.ElectricBolt" Color="Color.Primary" Style="font-size:2.5rem" />
            <MudText Typo="Typo.h5" Class="mt-1">
                <span style="color:var(--mud-palette-primary)">Gadget</span>Shop
            </MudText>
        </div>

        @if (!_sent)
        {
            <MudText Typo="Typo.h5" Class="fw-bold mt-4">Reset your password</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-5">
                Enter the email linked to your account and we'll send a reset link.
            </MudText>

            <MudTextField @bind-Value="_email"
                          Label="Email address"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Email"
                          Class="mb-4" />

            <ApiErrorAlert Errors="_errors" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Size="Size.Large" OnClick="SendResetAsync" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Send Reset Link
            </MudButton>
        }
        else
        {
            <div class="text-center mt-4">
                <MudIcon Icon="@Icons.Material.Rounded.MarkEmailRead"
                         Style="font-size:4rem;color:var(--mud-palette-success)" />
                <MudText Typo="Typo.h6" Class="mt-3 fw-bold">Check your inbox</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    A password reset link has been sent to <strong>@_email</strong>.
                    Check your spam folder if you don't see it.
                </MudText>
            </div>
        }

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.body2" Class="text-center">
            Remembered it?
            <MudLink Href="/login" Class="fw-semibold">Sign in</MudLink>
        </MudText>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private bool _loading;
    private bool _sent;
    private List<string>? _errors;

    private async Task SendResetAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
        {
            _errors = new() { "Please enter your email address." };
            return;
        }

        _loading = true;
        _errors = null;

        var res = await ApiClient.PostAsync<object, object>(
            ApiEndpoints.CustomerAccount.ForgotPassword,
            new { Email = _email });

        if (res.IsSuccess)
        {
            _sent = true;
        }
        else
        {
            // Backend may return 200 regardless for security; treat errors gracefully
            _errors = res.Errors.Count > 0 ? res.Errors : null;
            if (_errors == null) _sent = true; // show success anyway
        }

        _loading = false;
    }
}
