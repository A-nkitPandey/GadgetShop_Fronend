@page "/product/{Id:long}"
@inject CatalogService CatalogService
@inject CartService CartService
@inject WishlistService WishlistService
@inject CartState CartState
@inject WishlistState WishlistState
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(_product?.ProductName ?? "Product") - GadgetShop</PageTitle>

@if (_loading)
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSkeleton Height="450px" Class="rounded-xl" />
            <div class="d-flex gap-2 mt-2">
                @for (int i = 0; i < 4; i++)
                {
                    <MudSkeleton Width="80px" Height="80px" Class="rounded-lg" />
                }
            </div>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSkeleton Width="70%" Height="36px" Class="mb-3" />
            <MudSkeleton Width="40%" Height="28px" Class="mb-3" />
            <MudSkeleton Width="100%" Height="120px" Class="mb-3" />
            <MudSkeleton Width="100%" Height="50px" />
        </MudItem>
    </MudGrid>
}
else if (_product is null)
{
    <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Product not found"
                ActionHref="/catalog" ActionLabel="Back to Catalog" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <div class="gs-gallery">
                <div class="gs-gallery-main">
                    <img src="@_selectedImage" alt="@_product.ProductName" class="gs-gallery-img" />
                    @if (!_product.IsInStock)
                    {
                        <div class="gs-oos-badge">Out of Stock</div>
                    }
                </div>
                @if (_allImages.Count > 1)
                {
                    <div class="gs-gallery-thumbs">
                        @foreach (var img in _allImages)
                        {
                            <img src="@img"
                                 alt="thumb"
                                 class="gs-thumb @(_selectedImage == img ? "active" : "")"
                                 @onclick="@(() => _selectedImage = img)" />
                        }
                    </div>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <div class="gs-product-detail">
                <MudText Typo="Typo.overline" Color="Color.Primary">@_product.BrandName | @_product.CategoryName</MudText>
                <MudText Typo="Typo.h4" Class="gs-detail-title">@_product.ProductName</MudText>

                @if (_product.ReviewCount > 0)
                {
                    <div class="d-flex align-center gap-2 mt-2">
                        <MudRating ReadOnly="true"
                                   SelectedValue="(int)Math.Round(_product.AverageRating ?? 0)"
                                   Color="Color.Warning" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(_product.AverageRating?.ToString("F1")) (@_product.ReviewCount reviews)
                        </MudText>
                    </div>
                }

                <div class="gs-detail-price mt-3">
                    <MudText Typo="Typo.h3" Class="gs-price-big">&#8377;@_product.BasePrice.ToString("N0")</MudText>
                    @if (_product.Mrp.HasValue && _product.Mrp > _product.BasePrice)
                    {
                        var disc = (int)Math.Round((1 - _product.BasePrice / _product.Mrp.Value) * 100);
                        <MudText Typo="Typo.body1" Class="gs-mrp-big ml-3">&#8377;@_product.Mrp.Value.ToString("N0")</MudText>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-2">@disc% OFF</MudChip>
                    }
                </div>

                <div class="mt-2">
                    @if (_product.IsInStock)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Rounded.CheckCircle" Color="Color.Success" Size="Size.Small">In Stock (@_product.StockQuantity available)</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Small">Out of Stock</MudChip>
                    }
                </div>

                @if (_product.Variants.Count > 0)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Select Variant</MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var v in _product.Variants)
                        {
                            <MudChip T="string"
                                     Color="@(_selectedVariantId == v.Id ? Color.Primary : Color.Default)"
                                     Variant="@(_selectedVariantId == v.Id ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => SelectVariant(v))"
                                     Class="gs-variant-chip">
                                @v.VariantName
                                @if (v.Attributes.Any())
                                {
                                    <text> - @string.Join(", ", v.Attributes.Select(a => a.ValueText))</text>
                                }
                            </MudChip>
                        }
                    </div>
                }

                <MudDivider Class="my-3" />
                <AuthorizeView Roles="@AdminRoles">
                    <Authorized>
                        <MudPaper Outlined="true" Class="pa-4 gs-admin-view-panel">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">Admin view</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                Cart, wishlist, and review actions are reserved for customer accounts.
                            </MudText>
                        </MudPaper>
                    </Authorized>
                    <NotAuthorized>
                        <div class="gs-detail-actions mt-2">
                            <MudNumericField T="int"
                                             @bind-Value="_quantity"
                                             Label="Qty"
                                             Min="1"
                                             Max="10"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="gs-qty-field" />
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Rounded.AddShoppingCart"
                                       OnClick="AddToCartAsync"
                                       Disabled="@(!_product.IsInStock || _addingToCart)"
                                       Class="gs-add-to-cart-btn">
                                @if (_addingToCart)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Add to Cart
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Rounded.FavoriteBorder"
                                           Color="Color.Secondary"
                                           Variant="Variant.Outlined"
                                           Disabled="_wishlistBusy"
                                           OnClick="ToggleWishlistAsync" />
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                @if (!string.IsNullOrWhiteSpace(_product.Description))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Description</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_product.Description</MudText>
                }
            </div>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-6" />
    <div class="gs-reviews-section">
        <MudText Typo="Typo.h5" Class="mb-4">Customer Reviews</MudText>

        @if (_loadingReviews)
        {
            @for (int i = 0; i < 3; i++)
            {
                <MudSkeleton Height="80px" Class="mb-3 rounded-lg" />
            }
        }
        else if (_reviews.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Rounded.RateReview" Title="No reviews yet"
                        Subtitle="Be the first to review this product" />
        }
        else
        {
            @foreach (var r in _reviews)
            {
                <MudCard Elevation="0" Class="gs-review-card mb-3">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between">
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">@(r.ReviewerName?.FirstOrDefault())</MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2">@r.ReviewerName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@r.CreatedAt.ToString("MMM dd, yyyy")</MudText>
                                </div>
                            </div>
                            <MudRating ReadOnly="true" SelectedValue="r.Rating" Size="Size.Small" Color="Color.Warning" />
                        </div>
                        <MudText Typo="Typo.body2" Class="mt-2">@r.ReviewText</MudText>
                    </MudCardContent>
                </MudCard>
            }
        }

        <AuthorizeView Roles="@AppRoles.NormalUser">
            <Authorized>
                <MudCard Elevation="0" Class="gs-write-review mt-4">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle1" Class="mb-3 fw-bold">Write a Review</MudText>
                        <MudRating @bind-SelectedValue="_newReview.Rating" Color="Color.Warning" Class="mb-2" />
                        <MudTextField @bind-Value="_newReview.ReviewText"
                                      Label="Your review"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Class="mb-3" />
                        <ApiErrorAlert Errors="_reviewErrors" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="SubmitReviewAsync" Disabled="_submittingReview">
                            @if (_submittingReview)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Submit Review
                        </MudButton>
                    </MudCardContent>
                </MudCard>
            </Authorized>
        </AuthorizeView>
    </div>
}

@code {
    private const string AdminRoles = $"{AppRoles.Admin},{AppRoles.SuperAdmin}";

    [Parameter] public long Id { get; set; }

    private bool _loading = true;
    private bool _loadingReviews = true;
    private bool _addingToCart;
    private bool _wishlistBusy;
    private bool _submittingReview;
    private CustomerCatalogProductDto? _product;
    private List<ProductReviewDto> _reviews = new();
    private List<string> _allImages = new();
    private string _selectedImage = string.Empty;
    private long? _selectedVariantId;
    private int _quantity = 1;
    private ProductReviewMutationRequest _newReview = new();
    private List<string>? _reviewErrors;

    protected override async Task OnInitializedAsync()
    {
        var res = await CatalogService.GetProductByIdAsync(new CustomerCatalogGetByIdRequest { Id = Id });
        if (res.IsSuccess && res.Data is { } p)
        {
            _product = p;
            _allImages = p.GalleryImages.Count > 0 ? p.GalleryImages : new() { p.PrimaryImageUrl ?? string.Empty };
            _selectedImage = _allImages.FirstOrDefault() ?? string.Empty;
            _newReview.ProductId = Id;
        }
        _loading = false;

        var reviews = await CatalogService.GetReviewsAsync(new ProductReviewListRequest { ProductId = Id, PageNo = 1, PageSize = 20 });
        _reviews = reviews.Data?.Items ?? new();
        _loadingReviews = false;
    }

    private void SelectVariant(ProductVariantDto v)
    {
        _selectedVariantId = v.Id;
        if (!string.IsNullOrWhiteSpace(v.ImageUrl))
        {
            _selectedImage = v.ImageUrl;
        }
    }

    private async Task AddToCartAsync()
    {
        if (_addingToCart)
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!EnsureCustomerActionAccess(authState.User, "add this product to the cart"))
        {
            return;
        }

        _addingToCart = true;
        try
        {
            var res = await CartService.AddItemAsync(new AddCartItemRequest
            {
                ProductId = _product!.Id,
                VariantId = _selectedVariantId,
                Quantity = _quantity
            });

            if (res.IsSuccess)
            {
                CartState.SetCart(res.Data);
                Snackbar.Add("Added to cart!", Severity.Success);
            }
            else
            {
                Snackbar.Add(res.Errors.FirstOrDefault() ?? "Unable to add this item to the cart.", Severity.Error);
            }
        }
        finally
        {
            _addingToCart = false;
        }
    }

    private async Task ToggleWishlistAsync()
    {
        if (_wishlistBusy)
        {
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!EnsureCustomerActionAccess(authState.User, "save this product to the wishlist"))
        {
            return;
        }

        _wishlistBusy = true;
        try
        {
            var response = await WishlistService.AddAsync(new WishlistMutationRequest { ProductId = _product!.Id });
            if (response.IsSuccess)
            {
                WishlistState.SetCount(WishlistState.ItemCount + 1);
                Snackbar.Add("Added to wishlist!", Severity.Success);
            }
            else
            {
                Snackbar.Add(response.Errors.FirstOrDefault() ?? "Unable to save this item to the wishlist.", Severity.Error);
            }
        }
        finally
        {
            _wishlistBusy = false;
        }
    }

    private async Task SubmitReviewAsync()
    {
        _submittingReview = true;
        _reviewErrors = null;
        var response = await CatalogService.SaveReviewAsync(_newReview);
        if (response.IsSuccess)
        {
            Snackbar.Add("Review submitted!", Severity.Success);
            _newReview = new() { ProductId = Id };
            var reviews = await CatalogService.GetReviewsAsync(new ProductReviewListRequest { ProductId = Id, PageNo = 1, PageSize = 20 });
            _reviews = reviews.Data?.Items ?? new();
        }
        else
        {
            _reviewErrors = response.Errors;
        }
        _submittingReview = false;
    }

    private bool EnsureCustomerActionAccess(System.Security.Claims.ClaimsPrincipal user, string action)
    {
        if (user.Identity?.IsAuthenticated != true)
        {
            Snackbar.Add($"Please sign in to {action}.", Severity.Info);
            NavigateToLogin();
            return false;
        }

        if (AppRoles.IsAdmin(AppRoles.GetRoles(user)))
        {
            Snackbar.Add("Shopping actions are unavailable while you are using an admin account.", Severity.Info);
            return false;
        }

        return true;
    }

    private void NavigateToLogin()
    {
        var returnPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var destination = string.IsNullOrWhiteSpace(returnPath) ? "/" : $"/{returnPath}";
        NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(destination)}");
    }
}
