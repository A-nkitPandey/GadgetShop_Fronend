@page "/"
@inject CatalogService CatalogService
@inject NavigationManager Nav

<PageTitle>GadgetShop - Premium Electronics & Gadgets</PageTitle>

<section class="gs-hero">
    <div class="gs-hero-content">
        <MudText Typo="Typo.overline" Color="Color.Primary" Class="gs-hero-tag">Curated Tech Storefront</MudText>
        <MudText Typo="Typo.h2" Class="gs-hero-title">
            Discover standout gadgets with<br /><span class="gs-gradient-text">faster buying decisions</span>
        </MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-3">
            Browse launches, compare top picks, and jump from discovery to checkout without the clutter.
        </MudText>
        <div class="mt-6 d-flex gap-3 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       Href="/catalog" StartIcon="@Icons.Material.Rounded.RocketLaunch"
                       Class="gs-hero-btn">Shop now</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                       Href="/catalog?q=Deals" Class="gs-hero-btn">Explore deals</MudButton>
        </div>
        <div class="gs-hero-stats mt-8">
            <div class="gs-stat"><MudText Typo="Typo.h4" Class="gs-gradient-text">Fast</MudText><MudText Typo="Typo.caption">checkout flow</MudText></div>
            <div class="gs-stat"><MudText Typo="Typo.h4" Class="gs-gradient-text">Smart</MudText><MudText Typo="Typo.caption">recommendations</MudText></div>
            <div class="gs-stat"><MudText Typo="Typo.h4" Class="gs-gradient-text">Trusted</MudText><MudText Typo="Typo.caption">support & returns</MudText></div>
        </div>
    </div>
    <div class="gs-hero-visual">
        <div class="gs-hero-glow"></div>
        <MudIcon Icon="@Icons.Material.Rounded.Devices" Style="font-size:18rem;opacity:0.08" Color="Color.Primary" />
    </div>
</section>

<div class="gs-feature-strip">
    <div class="gs-feature-item"><MudIcon Icon="@Icons.Material.Rounded.LocalShipping" Color="Color.Primary" /><MudText Typo="Typo.body2">Free shipping on eligible carts</MudText></div>
    <div class="gs-feature-item"><MudIcon Icon="@Icons.Material.Rounded.Verified" Color="Color.Primary" /><MudText Typo="Typo.body2">Verified catalog and pricing</MudText></div>
    <div class="gs-feature-item"><MudIcon Icon="@Icons.Material.Rounded.SupportAgent" Color="Color.Primary" /><MudText Typo="Typo.body2">Responsive support</MudText></div>
    <div class="gs-feature-item"><MudIcon Icon="@Icons.Material.Rounded.Replay" Color="Color.Primary" /><MudText Typo="Typo.body2">Order and return visibility</MudText></div>
</div>

<section class="gs-section">
    <div class="gs-section-header">
        <MudText Typo="Typo.h4" Class="gs-section-title">Shop by Category</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/catalog" EndIcon="@Icons.Material.Rounded.ArrowForward">View all</MudButton>
    </div>
    <MudGrid>
        @foreach (var cat in _categories)
        {
            <MudItem xs="6" sm="4" md="2">
                <MudCard Class="gs-category-card" Elevation="0"
                         @onclick="@(() => Nav.NavigateTo($"/catalog?q={Uri.EscapeDataString(cat.Name)}"))">
                    <MudCardContent Class="text-center">
                        <MudIcon Icon="@cat.Icon" Color="Color.Primary" Style="font-size:2.5rem" />
                        <MudText Typo="Typo.subtitle2" Class="mt-2">@cat.Name</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</section>

<section class="gs-section">
    <div class="gs-section-header">
        <MudText Typo="Typo.h4" Class="gs-section-title">Trending Now</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/catalog" EndIcon="@Icons.Material.Rounded.ArrowForward">See all</MudButton>
    </div>

    @if (_loadingTrending)
    {
        <SkeletonGrid Count="4" />
    }
    else if (_trendingProducts.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Rounded.TrendingUp" Title="No trending products yet" />
    }
    else
    {
        <MudGrid>
            @foreach (var product in _trendingProducts)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <ProductCard Product="@product" />
                </MudItem>
            }
        </MudGrid>
    }
</section>

<section class="gs-promo-banner">
    <div class="gs-promo-content">
        <MudText Typo="Typo.overline" Color="Color.Warning">Storefront refresh</MudText>
        <MudText Typo="Typo.h4" Class="mt-1 fw-bold">Cleaner discovery, smoother conversion</MudText>
        <MudText Typo="Typo.body1" Class="mt-2">Designed to feel more like a modern ecommerce experience while staying consistent with your backend flows.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Href="/catalog" Class="mt-4">Browse catalog</MudButton>
    </div>
</section>

<section class="gs-section">
    <div class="gs-section-header">
        <MudText Typo="Typo.h4" Class="gs-section-title">Recommended Picks</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/catalog" EndIcon="@Icons.Material.Rounded.ArrowForward">See all</MudButton>
    </div>

    @if (_loadingRecommended)
    {
        <SkeletonGrid Count="4" />
    }
    else if (_recommendedProducts.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Rounded.AutoAwesome" Title="Recommendations will appear here" />
    }
    else
    {
        <MudGrid>
            @foreach (var product in _recommendedProducts)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <ProductCard Product="@product" />
                </MudItem>
            }
        </MudGrid>
    }
</section>

@code {
    private bool _loadingTrending = true;
    private bool _loadingRecommended = true;
    private List<CustomerCatalogProductDto> _trendingProducts = new();
    private List<CustomerCatalogProductDto> _recommendedProducts = new();

    private readonly List<(string Name, string Icon)> _categories =
    [
        ("Smartphones", Icons.Material.Rounded.PhoneAndroid),
        ("Laptops", Icons.Material.Rounded.LaptopMac),
        ("Audio", Icons.Material.Rounded.Headphones),
        ("Wearables", Icons.Material.Rounded.Watch),
        ("Cameras", Icons.Material.Rounded.Camera),
        ("Tablets", Icons.Material.Rounded.TabletMac)
    ];

    protected override async Task OnInitializedAsync()
    {
        var trendingTask = CatalogService.GetProductsAsync(new CustomerCatalogListRequest
        {
            PageNo = 1,
            PageSize = 8,
            SortBy = "trending"
        });

        var recommendationTask = CatalogService.GetRecommendationsAsync(pageSize: 8);

        var trending = await trendingTask;
        var recommended = await recommendationTask;

        _trendingProducts = trending.Data?.Items ?? new();
        _recommendedProducts = recommended.Data ?? new();
        _loadingTrending = false;
        _loadingRecommended = false;
    }
}
