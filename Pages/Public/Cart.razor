@page "/cart"
@inject CartService CartService
@inject CartState CartState
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Shopping Cart - GadgetShop</PageTitle>

<MudText Typo="Typo.h4" Class="gs-page-title mb-6">Shopping Cart</MudText>

@if (_loading)
{
    <MudGrid>
        <MudItem xs="12" md="8">
            @for (int i = 0; i < 3; i++)
            {
                <MudSkeleton Height="120px" Class="rounded-xl mb-3" />
            }
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSkeleton Height="320px" Class="rounded-xl" />
        </MudItem>
    </MudGrid>
}
else if (_adminViewBlocked)
{
    <EmptyState Icon="@Icons.Material.Rounded.AdminPanelSettings"
                Title="Cart is unavailable in admin view"
                Subtitle="Switch to a customer account to use cart and checkout features."
                ActionHref="/admin/dashboard"
                ActionLabel="Back to Dashboard" />
}
else if (_cart == null || _cart.Items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Rounded.ShoppingCart"
                Title="Your cart is empty"
                Subtitle="Add some awesome gadgets to get started!"
                ActionHref="/catalog"
                ActionLabel="Browse Products" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="8">
            @foreach (var item in _cart.Items)
            {
                <MudCard Elevation="0" Class="gs-cart-item mb-3">
                    <MudCardContent>
                        <div class="gs-cart-item-row">
                            <img src="@(item.ImageUrl ?? "https://via.placeholder.com/90x90?text=img")"
                                 alt="@item.ProductName"
                                 class="gs-cart-item-img" />

                            <div class="gs-cart-item-body">
                                <MudText Typo="Typo.subtitle1" Class="fw-semibold">@item.ProductName</MudText>
                                @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.VariantName</MudText>
                                }
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-1">&#8377;@item.UnitPrice.ToString("N0")</MudText>
                            </div>

                            <div class="gs-cart-item-meta">
                                <div class="gs-qty-stepper">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Remove"
                                                   Size="Size.Small"
                                                   OnClick="@(() => UpdateQtyAsync(item, item.Quantity - 1))"
                                                   Disabled="@(_updatingId == item.Id || GetDisplayedQuantity(item) <= 1)" />
                                    <MudText Typo="Typo.subtitle1" Class="px-3">@GetDisplayedQuantity(item)</MudText>
                                    <MudIconButton Icon="@Icons.Material.Rounded.Add"
                                                   Size="Size.Small"
                                                   OnClick="@(() => UpdateQtyAsync(item, item.Quantity + 1))"
                                                   Disabled="@(_updatingId == item.Id || GetDisplayedQuantity(item) >= item.AvailableStock)" />
                                    @if (_updatingId == item.Id)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-1" />
                                    }
                                </div>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold">&#8377;@GetDisplayedLineTotal(item).ToString("N0")</MudText>
                                <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => RemoveItemAsync(item))"
                                               Disabled="@(_removingId == item.Id)" />
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>
            }

            <div class="d-flex justify-end mt-2">
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Rounded.DeleteSweep"
                           OnClick="ClearCartAsync">Clear Cart</MudButton>
            </div>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="0" Class="gs-order-summary sticky-top">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-4">Order Summary</MudText>

                    <div class="gs-summary-row">
                        <MudText Typo="Typo.body2">Subtotal (@GetDisplayedItemCount() items)</MudText>
                        <MudText Typo="Typo.body2">&#8377;@GetDisplayedSubTotal().ToString("N0")</MudText>
                    </div>
                    @if (_cart.DiscountAmount > 0)
                    {
                        <div class="gs-summary-row">
                            <MudText Typo="Typo.body2" Color="Color.Success">Discount</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Success">-&#8377;@_cart.DiscountAmount.ToString("N0")</MudText>
                        </div>
                    }
                    <div class="gs-summary-row">
                        <MudText Typo="Typo.body2">Shipping</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Success">
                            @(_cart.TotalAmount >= 999 ? "FREE" : "₹99")
                        </MudText>
                    </div>
                    <MudDivider Class="my-3" />
                    <div class="gs-summary-row">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Total</MudText>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Primary">
                            &#8377;@GetDisplayedTotal().ToString("N0")
                        </MudText>
                    </div>

                    <MudDivider Class="my-3" />
                    @if (!string.IsNullOrWhiteSpace(_cart.AppliedCouponCode))
                    {
                        <div class="d-flex align-center justify-space-between gs-coupon-applied">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Rounded.LocalOffer" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Color="Color.Success">@_cart.AppliedCouponCode applied</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small"
                                           OnClick="RemoveCouponAsync" />
                        </div>
                    }
                    else
                    {
                        <div class="gs-coupon-entry">
                            <MudTextField @bind-Value="_couponCode"
                                          Label="Coupon Code"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Class="flex-grow-1" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="ApplyCouponAsync" Disabled="_applyingCoupon">Apply</MudButton>
                        </div>
                        <ApiErrorAlert Errors="_couponErrors" />
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Size="Size.Large" Class="mt-4" Href="/checkout"
                               EndIcon="@Icons.Material.Rounded.ArrowForward">
                        Proceed to Checkout
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true"
                               Class="mt-1" Href="/catalog">Continue Shopping</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private bool _adminViewBlocked;
    private CartDto? _cart;
    private string _couponCode = string.Empty;
    private bool _applyingCoupon;
    private List<string>? _couponErrors;
    private long _updatingId;
    private long _removingId;
    private readonly Dictionary<long, int> _pendingQuantities = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (AppRoles.IsAdmin(AppRoles.GetRoles(authState.User)))
        {
            _adminViewBlocked = true;
            _loading = false;
            return;
        }

        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        if (CartState.IsInitialized)
        {
            _cart = CartState.Cart;
            _loading = false;
            return;
        }

        _loading = true;
        var res = await CartService.GetMyCartAsync();
        if (res.IsSuccess)
        {
            _cart = res.Data;
            CartState.SetCart(res.Data);
        }
        _loading = false;
    }

    private async Task UpdateQtyAsync(CartItemDto item, int qty)
    {
        if (_cart == null || qty < 1 || _updatingId == item.Id)
        {
            return;
        }

        var currentQuantity = GetDisplayedQuantity(item);
        if (qty == currentQuantity)
        {
            return;
        }

        _pendingQuantities[item.Id] = qty;
        _updatingId = item.Id;
        await InvokeAsync(StateHasChanged);

        var res = await CartService.UpdateQuantityAsync(new UpdateCartItemQuantityRequest
        {
            CartItemId = item.Id,
            Quantity = qty
        });
        if (res.IsSuccess)
        {
            _cart = res.Data;
            CartState.SetCart(res.Data);
            _pendingQuantities.Clear();
        }
        else
        {
            _pendingQuantities.Remove(item.Id);
            Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error", Severity.Error);
        }
        _updatingId = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveItemAsync(CartItemDto item)
    {
        _removingId = item.Id;
        var res = await CartService.RemoveItemAsync(new RemoveCartItemRequest { CartItemId = item.Id });
        if (res.IsSuccess)
        {
            _cart = res.Data;
            CartState.SetCart(res.Data);
            _pendingQuantities.Remove(item.Id);
            Snackbar.Add("Item removed", Severity.Info);
        }
        else
        {
            Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error", Severity.Error);
        }
        _removingId = 0;
    }

    private async Task ClearCartAsync()
    {
        await CartService.ClearCartAsync();
        _cart = null;
        _pendingQuantities.Clear();
        CartState.Clear();
        Snackbar.Add("Cart cleared", Severity.Info);
    }

    private int GetDisplayedQuantity(CartItemDto item) =>
        _pendingQuantities.TryGetValue(item.Id, out var pendingQty) ? pendingQty : item.Quantity;

    private decimal GetDisplayedLineTotal(CartItemDto item) => item.UnitPrice * GetDisplayedQuantity(item);

    private int GetDisplayedItemCount() => _cart?.Items.Sum(GetDisplayedQuantity) ?? 0;

    private decimal GetDisplayedSubTotal() => _cart?.Items.Sum(GetDisplayedLineTotal) ?? 0m;

    private decimal GetDisplayedTotal()
    {
        if (_cart == null)
        {
            return 0m;
        }

        return Math.Max(GetDisplayedSubTotal() - _cart.DiscountAmount, 0m);
    }

    private async Task ApplyCouponAsync()
    {
        if (string.IsNullOrWhiteSpace(_couponCode))
        {
            return;
        }

        _applyingCoupon = true;
        _couponErrors = null;
        var res = await CartService.ApplyCouponAsync(new ApplyCartCouponRequest { CouponCode = _couponCode });
        if (res.IsSuccess)
        {
            _cart = res.Data;
            CartState.SetCart(res.Data);
            Snackbar.Add("Coupon applied!", Severity.Success);
            _couponCode = string.Empty;
        }
        else
        {
            _couponErrors = res.Errors;
        }
        _applyingCoupon = false;
    }

    private async Task RemoveCouponAsync()
    {
        var res = await CartService.RemoveCouponAsync();
        if (res.IsSuccess)
        {
            _cart = res.Data;
            CartState.SetCart(res.Data);
            Snackbar.Add("Coupon removed", Severity.Info);
        }
    }
}
