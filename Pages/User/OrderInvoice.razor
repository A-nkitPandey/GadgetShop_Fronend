@page "/account/orders/{OrderId:long}/invoice"
@layout GadgetShop.Layout.PrintLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderService
@inject IJSRuntime JSRuntime

<PageTitle>Invoice - GadgetShop</PageTitle>

@if (_loading)
{
    <MudSkeleton Height="500px" Class="rounded-xl" />
}
else if (_invoice == null)
{
    <EmptyState Icon="@Icons.Material.Rounded.ReceiptLong" Title="Invoice not available yet" ActionHref="@($"/account/orders/{OrderId}")" ActionLabel="Back to Order" />
}
else
{
    <div class="d-flex justify-space-between align-center mb-4 gs-no-print">
        <MudText Typo="Typo.h4" Class="gs-page-title">Invoice #@_invoice.InvoiceNo</MudText>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/account/orders/{OrderId}")">
                Back to Order
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Print" OnClick="PrintAsync">
                Print
            </MudButton>
        </div>
    </div>

    <MudPaper Class="pa-4 gs-print-document">
        @((MarkupString)_invoice.HtmlContent)
    </MudPaper>
}

@code {
    [Parameter] public long OrderId { get; set; }

    private bool _loading = true;
    private InvoicePrintDocumentDto? _invoice;

    protected override async Task OnInitializedAsync()
    {
        var response = await OrderService.GetMyInvoiceAsync(new OrderGetByIdRequest { Id = OrderId });
        _invoice = response.Data;
        _loading = false;
    }

    private Task PrintAsync() => JSRuntime.InvokeVoidAsync("print").AsTask();
}
