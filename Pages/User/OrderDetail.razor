@page "/account/orders/{OrderId:long}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderService
@inject PaymentService PaymentService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Order Details - GadgetShop</PageTitle>

@if (_loading)
{
    <MudSkeleton Height="500px" Class="rounded-xl" />
}
else if (_order == null)
{
    <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Order not found" ActionHref="/account/orders" ActionLabel="Back to Orders" />
}
else
{
    <section class="gs-order-hero mb-6">
        <div class="gs-order-hero-copy">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Href="/account/orders" />
                <MudChip T="string" Color="@GetStatusColor(_order.Status)" Size="Size.Small">@AppConstants.OrderStatus.GetLabel(_order.Status)</MudChip>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                    Payment: @(_order.PaymentStatus ?? "Pending")
                </MudChip>
            </div>
            <MudText Typo="Typo.h4" Class="gs-page-title mb-2">Order #@_order.OrderNo</MudText>
            <MudText Typo="Typo.body1" Class="gs-order-hero-text">
                Placed on @_order.CreatedAt.ToString("dd MMM yyyy") with @_order.TotalQuantity item(s). Track payment, shipment, and returns from one place.
            </MudText>
        </div>
        <div class="gs-order-hero-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.ReceiptLong" OnClick="OpenInvoice">
                View Invoice
            </MudButton>
            @if (CanContinuePayment())
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Rounded.Payments"
                           OnClick="ResumePaymentAsync"
                           Disabled="_initiatingPayment">
                    @if (_initiatingPayment) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Complete Payment
                </MudButton>
            }
            @if (_order.Shipment?.TrackingNo is { Length: > 0 })
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Rounded.ContentCopy" OnClick="CopyTrackingAsync">
                    Copy Tracking
                </MudButton>
            }
        </div>
    </section>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Items Ordered</MudText>
                    @foreach (var item in _order.Items)
                    {
                        <div class="d-flex align-center gap-3 py-2 gs-order-item-row">
                            <div class="gs-order-item-thumb gs-more-items">@item.Quantity x</div>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">@item.ProductName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Qty: @item.Quantity x &#8377;@item.UnitPrice.ToString("N0")
                                </MudText>
                            </div>
                            <div class="d-flex flex-column align-end gap-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">&#8377;@item.TotalPrice.ToString("N0")</MudText>
                                @if (CanRequestReturn(item))
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Rounded.AssignmentReturn"
                                               OnClick="@(() => OpenReturnDialog(item))">
                                        Request Return
                                    </MudButton>
                                }
                            </div>
                        </div>
                    }
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                        <MudText Typo="Typo.h6" Class="fw-bold">Order Timeline</MudText>
                        <MudChip T="string" Variant="Variant.Outlined" Color="@GetStatusColor(_order.Status)">
                            @GetTimelineCaption()
                        </MudChip>
                    </div>
                    <div class="gs-order-journey">
                        @foreach (var step in GetJourneySteps())
                        {
                            <div class="gs-order-journey-step @(step.IsCompleted ? "completed" : step.IsActive ? "active" : string.Empty)">
                                <div class="gs-order-journey-dot">
                                    <MudIcon Icon="@step.Icon" Size="Size.Small" />
                                </div>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@step.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@step.Description</MudText>
                                    @if (!string.IsNullOrWhiteSpace(step.Timestamp))
                                    {
                                        <MudText Typo="Typo.caption" Class="gs-order-step-time">@step.Timestamp</MudText>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                        <MudText Typo="Typo.h6" Class="fw-bold">Shipment & Tracking</MudText>
                        @if (_order.Shipment != null)
                        {
                            <MudChip T="string" Variant="Variant.Filled" Color="@GetShipmentColor(_order.Shipment.ShipmentStatus)">
                                @AppConstants.ShipmentStatus.GetLabel(_order.Shipment.ShipmentStatus)
                            </MudChip>
                        }
                    </div>
                    @if (_order.Shipment != null)
                    {
                        <div class="gs-tracking-spotlight mb-4">
                            <div>
                                <MudText Typo="Typo.caption" Class="text-uppercase fw-semibold">Tracking ID</MudText>
                                <MudText Typo="Typo.h6" Class="fw-bold">@(_order.Shipment.TrackingNo ?? "Pending Assignment")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Shipment #@_order.Shipment.ShipmentNo via @_order.Shipment.CourierPartner
                                </MudText>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                @if (!string.IsNullOrWhiteSpace(_order.Shipment.TrackingNo))
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.ContentCopy" OnClick="CopyTrackingAsync">
                                        Copy
                                    </MudButton>
                                }
                            </div>
                        </div>

                        <MudGrid>
                            <MudItem xs="12" sm="6"><div class="gs-ticket-stat"><span>Shipment No</span><strong>@_order.Shipment.ShipmentNo</strong></div></MudItem>
                            <MudItem xs="12" sm="6"><div class="gs-ticket-stat"><span>Courier</span><strong>@_order.Shipment.CourierPartner</strong></div></MudItem>
                            <MudItem xs="12" sm="6"><div class="gs-ticket-stat"><span>Shipped At</span><strong>@FormatShipmentDate(_order.Shipment.ShippedAt)</strong></div></MudItem>
                            <MudItem xs="12" sm="6"><div class="gs-ticket-stat"><span>Delivered At</span><strong>@FormatShipmentDate(_order.Shipment.DeliveredAt)</strong></div></MudItem>
                        </MudGrid>

                        @if (!string.IsNullOrWhiteSpace(_order.Shipment.Remarks))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-4">
                                @_order.Shipment.Remarks
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <div class="gs-premium-empty">
                            <MudIcon Icon="@Icons.Material.Rounded.Inventory2" Size="Size.Large" Color="Color.Primary" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">Shipment not created yet</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">We’ll show courier, tracking, and delivery milestones here as soon as dispatch starts.</MudText>
                            </div>
                        </div>
                    }
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.h6" Class="fw-bold">Returns</MudText>
                        @if (CanRequestReturn())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Select an item above to raise a return request.
                            </MudText>
                        }
                    </div>
                    @if (_order.Returns.Count == 0)
                    {
                        <div class="gs-premium-empty">
                            <MudIcon Icon="@Icons.Material.Rounded.AssignmentReturn" Size="Size.Large" Color="Color.Primary" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">No returns raised</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">If something is wrong with an item, choose it above and raise a return request with a clear reason.</MudText>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in _order.Returns)
                        {
                            <MudPaper Class="pa-3 mb-2" Outlined="true">
                                <div class="gs-summary-row"><MudText Typo="Typo.body2">Return #</MudText><MudText Typo="Typo.body2">@item.ReturnNo</MudText></div>
                                <div class="gs-summary-row"><MudText Typo="Typo.body2">Status</MudText><MudText Typo="Typo.body2">@item.ReturnStatus</MudText></div>
                                @if (!string.IsNullOrWhiteSpace(item.Reason))
                                {
                                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Reason</MudText><MudText Typo="Typo.body2">@item.Reason</MudText></div>
                                }
                                @if (item.Quantity > 0)
                                {
                                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Quantity</MudText><MudText Typo="Typo.body2">@item.Quantity</MudText></div>
                                }
                                <div class="gs-summary-row"><MudText Typo="Typo.body2">Requested</MudText><MudText Typo="Typo.body2">@item.RequestedAt.ToString("dd MMM yyyy")</MudText></div>
                            </MudPaper>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Order Summary</MudText>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Order Date</MudText><MudText Typo="Typo.body2">@_order.CreatedAt.ToString("dd MMM yyyy")</MudText></div>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Items</MudText><MudText Typo="Typo.body2">@_order.TotalQuantity</MudText></div>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Payment Status</MudText><MudText Typo="Typo.body2">@(_order.PaymentStatus ?? "N/A")</MudText></div>
                    <MudDivider Class="my-2" />
                    <div class="gs-summary-row">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Total</MudText>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Primary">&#8377;@_order.TotalAmount.ToString("N0")</MudText>
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Need Help?</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        For shipment or address help, contact support and reference order number
                        <strong>@_order.OrderNo</strong>.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_showReturnDialog && _selectedReturnItem != null)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="200">
            <div class="gs-modal-wrap">
                <div class="gs-modal-header">
                    <MudText Typo="Typo.h6">Request Return</MudText>
                </div>
                <div class="gs-modal-body">
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Item: <strong>@_selectedReturnItem.ProductName</strong>
                    </MudText>
                    <MudNumericField T="int"
                                     @bind-Value="_returnRequest.Quantity"
                                     Label="Quantity"
                                     Min="1"
                                     Max="@Math.Max(1, _selectedReturnItem.Quantity)"
                                     Variant="Variant.Outlined"
                                     Class="mb-3" />
                    <MudSelect T="string"
                               @bind-Value="_returnRequest.Reason"
                               Label="Reason"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var reason in ReturnReasons)
                        {
                            <MudSelectItem T="string" Value="@reason">@reason</MudSelectItem>
                        }
                    </MudSelect>
                    <ApiErrorAlert Errors="_returnErrors" />
                </div>
                <div class="gs-modal-footer">
                    <MudButton OnClick="CloseReturnDialog">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="SubmitReturnAsync"
                               Disabled="_submittingReturn">
                        @if (_submittingReturn) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Submit Request
                    </MudButton>
                </div>
            </div>
        </MudOverlay>
    }
}

@code {
    private static readonly string[] ReturnReasons =
    {
        "Damaged item",
        "Wrong item delivered",
        "Defective product",
        "Quality not as expected",
        "No longer needed"
    };

    [Parameter] public long OrderId { get; set; }

    private bool _loading = true;
    private bool _showReturnDialog;
    private bool _submittingReturn;
    private bool _initiatingPayment;
    private OrderDto? _order;
    private OrderItemDto? _selectedReturnItem;
    private CreateOrderReturnRequest _returnRequest = new();
    private List<string>? _returnErrors;
    private DotNetObjectReference<GadgetShop.Pages.User.OrderDetail>? _dotnetRef;
    private string? _payerName;
    private string? _payerEmail;
    private string? _payerPhone;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayerContextAsync();
        await LoadOrderAsync();
        _loading = false;
    }

    private void OpenInvoice() => NavigationManager.NavigateTo($"/account/orders/{OrderId}/invoice");

    private bool CanRequestReturn() =>
        _order?.Items.Count > 0 && !string.Equals(_order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);

    private bool CanRequestReturn(OrderItemDto item) =>
        CanRequestReturn() && item.Quantity > 0;

    private bool CanContinuePayment() =>
        _order != null &&
        !string.Equals(_order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) &&
        (string.Equals(_order.PaymentStatus, "Created", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(_order.PaymentStatus, "Pending", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(_order.PaymentStatus, "Failed", StringComparison.OrdinalIgnoreCase));

    private void OpenReturnDialog(OrderItemDto item)
    {
        _selectedReturnItem = item;
        _returnErrors = null;
        _returnRequest = new CreateOrderReturnRequest
        {
            OrderId = OrderId,
            OrderItemId = item.Id,
            Quantity = 1,
            Reason = ReturnReasons[0]
        };
        _showReturnDialog = true;
    }

    private void CloseReturnDialog()
    {
        _showReturnDialog = false;
        _selectedReturnItem = null;
        _returnErrors = null;
    }

    private async Task SubmitReturnAsync()
    {
        if (_selectedReturnItem == null)
            return;

        _submittingReturn = true;
        _returnErrors = null;
        _returnRequest.Quantity = Math.Clamp(_returnRequest.Quantity, 1, Math.Max(1, _selectedReturnItem.Quantity));

        var response = await OrderService.CreateReturnAsync(_returnRequest);
        if (response.IsSuccess)
        {
            Snackbar.Add("Return request submitted.", Severity.Success);
            await LoadReturnsAsync();
            CloseReturnDialog();
        }
        else
        {
            _returnErrors = response.Errors;
        }

        _submittingReturn = false;
    }

    private async Task LoadOrderAsync()
    {
        var res = await OrderService.GetMyOrderByIdAsync(new OrderGetByIdRequest { Id = OrderId });
        _order = res.Data;
        if (_order == null)
            return;

        var shipmentTask = OrderService.GetMyShipmentByOrderIdAsync(new OrderShipmentGetByOrderIdRequest { OrderId = OrderId });
        var returnTask = OrderService.GetMyReturnListAsync(new MyReturnListRequest { PageNo = 1, PageSize = 20 });
        await Task.WhenAll(shipmentTask, returnTask);

        _order.Shipment = shipmentTask.Result.Data;
        _order.Returns = returnTask.Result.Data?.Items.Where(item => item.OrderId == OrderId).ToList() ?? new();
    }

    private async Task LoadReturnsAsync()
    {
        if (_order == null)
            return;

        var response = await OrderService.GetMyReturnListAsync(new MyReturnListRequest { PageNo = 1, PageSize = 20 });
        _order.Returns = response.Data?.Items.Where(item => item.OrderId == OrderId).ToList() ?? new();
    }

    private async Task ResumePaymentAsync()
    {
        if (_order == null)
            return;

        _initiatingPayment = true;
        var response = await PaymentService.RetryPaymentAsync(new RetryPaymentRequest
        {
            OrderId = OrderId,
            IdempotencyKey = Guid.NewGuid().ToString("N")
        });

        if (!response.IsSuccess || response.Data == null)
        {
            Snackbar.Add(response.Errors.FirstOrDefault() ?? "Payment initiation failed", Severity.Error);
            _initiatingPayment = false;
            return;
        }

        var payment = response.Data;
        _dotnetRef?.Dispose();
        _dotnetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("initiateRazorpay", BuildPaymentOptions(payment), _dotnetRef);
    }

    [JSInvokable]
    public async Task OnPaymentSuccess(object response)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(response);
        var dict = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json);

        var verifyResponse = await PaymentService.VerifyPaymentAsync(new VerifyPaymentRequest
        {
            OrderId = OrderId,
            RazorpayOrderId = dict?.GetValueOrDefault("razorpay_order_id"),
            RazorpayPaymentId = dict?.GetValueOrDefault("razorpay_payment_id"),
            RazorpaySignature = dict?.GetValueOrDefault("razorpay_signature")
        });

        if (verifyResponse.IsSuccess)
        {
            Snackbar.Add("Payment verified successfully.", Severity.Success);
            await LoadOrderAsync();
            StateHasChanged();
        }
        else
        {
            Snackbar.Add(verifyResponse.Errors.FirstOrDefault() ?? "Verification failed", Severity.Error);
        }

        _initiatingPayment = false;
    }

    private async Task CopyTrackingAsync()
    {
        if (string.IsNullOrWhiteSpace(_order?.Shipment?.TrackingNo))
            return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _order.Shipment.TrackingNo);
        Snackbar.Add("Tracking number copied.", Severity.Success);
    }

    [JSInvokable]
    public void OnPaymentFailed(object error)
    {
        Snackbar.Add(GetPaymentErrorMessage(error), Severity.Error);
        _initiatingPayment = false;
        StateHasChanged();
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "DELIVERED" => Color.Success,
        "SHIPPED" => Color.Info,
        "CANCELLED" => Color.Error,
        "PROCESSING" => Color.Primary,
        _ => Color.Warning
    };

    private Color GetShipmentColor(string? status) => status switch
    {
        "DELIVERED" => Color.Success,
        "DISPATCHED" => Color.Info,
        _ => Color.Warning
    };

    private string GetTimelineCaption() =>
        _order?.Status switch
        {
            "DELIVERED" => "Delivered successfully",
            "SHIPPED" => "On the way",
            "CANCELLED" => "Order cancelled",
            _ => "In progress"
        };

    private string FormatShipmentDate(DateTime? value) =>
        value?.ToString("dd MMM yyyy, hh:mm tt") ?? "Awaiting update";

    private IEnumerable<(string Title, string Description, string Icon, bool IsCompleted, bool IsActive, string? Timestamp)> GetJourneySteps()
    {
        var status = _order?.Status?.ToUpperInvariant() ?? string.Empty;
        var shipmentStatus = _order?.Shipment?.ShipmentStatus?.ToUpperInvariant() ?? string.Empty;
        yield return ("Order placed", "We have received your order and confirmed the request.", Icons.Material.Rounded.ReceiptLong, true, status == "PLACED", _order?.CreatedAt.ToString("dd MMM yyyy, hh:mm tt"));
        yield return ("Processing", "Your items are being prepared for handoff.", Icons.Material.Rounded.Inventory2, status is "PROCESSING" or "SHIPPED" or "DELIVERED", status == "PROCESSING", status is "PROCESSING" or "SHIPPED" or "DELIVERED" ? "Workflow active" : null);
        yield return ("Dispatched", "The courier has picked up your shipment.", Icons.Material.Rounded.LocalShipping, shipmentStatus is "DISPATCHED" or "DELIVERED" || status is "SHIPPED" or "DELIVERED", shipmentStatus == "DISPATCHED" || status == "SHIPPED", FormatJourneyDate(_order?.Shipment?.ShippedAt));
        yield return ("Delivered", "The shipment has reached your delivery address.", Icons.Material.Rounded.Home, shipmentStatus == "DELIVERED" || status == "DELIVERED", shipmentStatus == "DELIVERED" || status == "DELIVERED", FormatJourneyDate(_order?.Shipment?.DeliveredAt));
    }

    private static string? FormatJourneyDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy, hh:mm tt") : null;

    private async Task LoadPayerContextAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _payerName =
            user.FindFirst("FullName")?.Value ??
            user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ??
            user.Identity?.Name;
        _payerEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
        _payerPhone = user.FindFirst("PhoneNumber")?.Value;
    }

    private object BuildPaymentOptions(PaymentOrderDto payment)
    {
        var amountInSubunits = payment.AmountInSubunits > 0
            ? payment.AmountInSubunits
            : (long)Math.Round(payment.Amount * 100, MidpointRounding.AwayFromZero);

        return new
        {
            key = payment.GatewayKey,
            amount = amountInSubunits,
            currency = payment.Currency ?? "INR",
            name = "GadgetShop",
            description = $"Order #{_order?.OrderNo}",
            order_id = payment.GatewayOrderId,
            prefill = new
            {
                name = _payerName,
                email = _payerEmail,
                contact = _payerPhone
            },
            notes = new
            {
                orderNo = _order?.OrderNo
            },
            theme = new
            {
                color = "#7C3AED"
            },
            retry = new
            {
                enabled = true
            },
            modal = new
            {
                confirm_close = true
            }
        };
    }

    private static string GetPaymentErrorMessage(object? error)
    {
        if (error is null)
        {
            return "Payment failed";
        }

        var json = System.Text.Json.JsonSerializer.Serialize(error);
        var payload = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(json);
        if (payload != null)
        {
            if (payload.TryGetValue("description", out var description) && description.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return description.GetString() ?? "Payment failed";
            }

            if (payload.TryGetValue("reason", out var reason) && reason.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return reason.GetString() ?? "Payment failed";
            }

            if (payload.TryGetValue("step", out var step) && step.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return $"Payment failed at {step.GetString()} step.";
            }
        }

        return error.ToString() ?? "Payment failed";
    }

    public void Dispose() => _dotnetRef?.Dispose();
}
