@page "/account/orders/{OrderId:long}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Order Details - GadgetShop</PageTitle>

@if (_loading)
{
    <MudSkeleton Height="500px" Class="rounded-xl" />
}
else if (_order == null)
{
    <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Order not found" ActionHref="/account/orders" ActionLabel="Back to Orders" />
}
else
{
    <div class="d-flex align-center gap-3 mb-6">
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Href="/account/orders" />
        <MudText Typo="Typo.h4" Class="gs-page-title">Order #@_order.OrderNo</MudText>
        <MudChip T="string" Color="@GetStatusColor(_order.Status)" Size="Size.Small">@_order.Status</MudChip>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.ReceiptLong" OnClick="OpenInvoice">
            View Invoice
        </MudButton>
        @if (_order.Shipment?.TrackingNo is { Length: > 0 })
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Rounded.LocalShipping">
                Tracking: @_order.Shipment.TrackingNo
            </MudButton>
        }
    </div>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Items Ordered</MudText>
                    @foreach (var item in _order.Items)
                    {
                        <div class="d-flex align-center gap-3 py-2 gs-order-item-row">
                            <div class="gs-order-item-thumb gs-more-items">@item.Quantity x</div>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">@item.ProductName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Qty: @item.Quantity x &#8377;@item.UnitPrice.ToString("N0")
                                </MudText>
                            </div>
                            <div class="d-flex flex-column align-end gap-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">&#8377;@item.TotalPrice.ToString("N0")</MudText>
                                @if (CanRequestReturn(item))
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Rounded.AssignmentReturn"
                                               OnClick="@(() => OpenReturnDialog(item))">
                                        Request Return
                                    </MudButton>
                                }
                            </div>
                        </div>
                    }
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Order Timeline</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        This order is currently <strong>@_order.Status</strong>. Payment status is
                        <strong>@(_order.PaymentStatus ?? "Pending")</strong>.
                    </MudText>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Shipment</MudText>
                    @if (_order.Shipment != null)
                    {
                        <div class="gs-summary-row"><MudText Typo="Typo.body2">Shipment #</MudText><MudText Typo="Typo.body2">@_order.Shipment.ShipmentNo</MudText></div>
                        <div class="gs-summary-row"><MudText Typo="Typo.body2">Status</MudText><MudText Typo="Typo.body2">@_order.Shipment.ShipmentStatus</MudText></div>
                        <div class="gs-summary-row"><MudText Typo="Typo.body2">Courier</MudText><MudText Typo="Typo.body2">@_order.Shipment.CourierPartner</MudText></div>
                        <div class="gs-summary-row"><MudText Typo="Typo.body2">Tracking</MudText><MudText Typo="Typo.body2">@(_order.Shipment.TrackingNo ?? "Pending")</MudText></div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Shipment has not been created yet.</MudText>
                    }
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudText Typo="Typo.h6" Class="fw-bold">Returns</MudText>
                        @if (CanRequestReturn())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Select an item above to raise a return request.
                            </MudText>
                        }
                    </div>
                    @if (_order.Returns.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No returns raised for this order.</MudText>
                    }
                    else
                    {
                        @foreach (var item in _order.Returns)
                        {
                            <MudPaper Class="pa-3 mb-2" Outlined="true">
                                <div class="gs-summary-row"><MudText Typo="Typo.body2">Return #</MudText><MudText Typo="Typo.body2">@item.ReturnNo</MudText></div>
                                <div class="gs-summary-row"><MudText Typo="Typo.body2">Status</MudText><MudText Typo="Typo.body2">@item.ReturnStatus</MudText></div>
                                @if (!string.IsNullOrWhiteSpace(item.Reason))
                                {
                                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Reason</MudText><MudText Typo="Typo.body2">@item.Reason</MudText></div>
                                }
                                @if (item.Quantity > 0)
                                {
                                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Quantity</MudText><MudText Typo="Typo.body2">@item.Quantity</MudText></div>
                                }
                                <div class="gs-summary-row"><MudText Typo="Typo.body2">Requested</MudText><MudText Typo="Typo.body2">@item.RequestedAt.ToString("dd MMM yyyy")</MudText></div>
                            </MudPaper>
                        }
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Order Summary</MudText>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Order Date</MudText><MudText Typo="Typo.body2">@_order.CreatedAt.ToString("dd MMM yyyy")</MudText></div>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Items</MudText><MudText Typo="Typo.body2">@_order.TotalQuantity</MudText></div>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Payment Status</MudText><MudText Typo="Typo.body2">@(_order.PaymentStatus ?? "N/A")</MudText></div>
                    <MudDivider Class="my-2" />
                    <div class="gs-summary-row">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Total</MudText>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Primary">&#8377;@_order.TotalAmount.ToString("N0")</MudText>
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="0" Class="gs-detail-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-2">Need Help?</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        For shipment or address help, contact support and reference order number
                        <strong>@_order.OrderNo</strong>.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_showReturnDialog && _selectedReturnItem != null)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="200">
            <div class="gs-modal-wrap">
                <div class="gs-modal-header">
                    <MudText Typo="Typo.h6">Request Return</MudText>
                </div>
                <div class="gs-modal-body">
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Item: <strong>@_selectedReturnItem.ProductName</strong>
                    </MudText>
                    <MudNumericField T="int"
                                     @bind-Value="_returnRequest.Quantity"
                                     Label="Quantity"
                                     Min="1"
                                     Max="@Math.Max(1, _selectedReturnItem.Quantity)"
                                     Variant="Variant.Outlined"
                                     Class="mb-3" />
                    <MudSelect T="string"
                               @bind-Value="_returnRequest.Reason"
                               Label="Reason"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var reason in ReturnReasons)
                        {
                            <MudSelectItem T="string" Value="@reason">@reason</MudSelectItem>
                        }
                    </MudSelect>
                    <ApiErrorAlert Errors="_returnErrors" />
                </div>
                <div class="gs-modal-footer">
                    <MudButton OnClick="CloseReturnDialog">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="SubmitReturnAsync"
                               Disabled="_submittingReturn">
                        @if (_submittingReturn) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        Submit Request
                    </MudButton>
                </div>
            </div>
        </MudOverlay>
    }
}

@code {
    private static readonly string[] ReturnReasons =
    {
        "Damaged item",
        "Wrong item delivered",
        "Defective product",
        "Quality not as expected",
        "No longer needed"
    };

    [Parameter] public long OrderId { get; set; }

    private bool _loading = true;
    private bool _showReturnDialog;
    private bool _submittingReturn;
    private OrderDto? _order;
    private OrderItemDto? _selectedReturnItem;
    private CreateOrderReturnRequest _returnRequest = new();
    private List<string>? _returnErrors;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderAsync();
        _loading = false;
    }

    private void OpenInvoice() => NavigationManager.NavigateTo($"/account/orders/{OrderId}/invoice");

    private bool CanRequestReturn() =>
        _order?.Items.Count > 0 && !string.Equals(_order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);

    private bool CanRequestReturn(OrderItemDto item) =>
        CanRequestReturn() && item.Quantity > 0;

    private void OpenReturnDialog(OrderItemDto item)
    {
        _selectedReturnItem = item;
        _returnErrors = null;
        _returnRequest = new CreateOrderReturnRequest
        {
            OrderId = OrderId,
            OrderItemId = item.Id,
            Quantity = 1,
            Reason = ReturnReasons[0]
        };
        _showReturnDialog = true;
    }

    private void CloseReturnDialog()
    {
        _showReturnDialog = false;
        _selectedReturnItem = null;
        _returnErrors = null;
    }

    private async Task SubmitReturnAsync()
    {
        if (_selectedReturnItem == null)
            return;

        _submittingReturn = true;
        _returnErrors = null;
        _returnRequest.Quantity = Math.Clamp(_returnRequest.Quantity, 1, Math.Max(1, _selectedReturnItem.Quantity));

        var response = await OrderService.CreateReturnAsync(_returnRequest);
        if (response.IsSuccess)
        {
            Snackbar.Add("Return request submitted.", Severity.Success);
            await LoadReturnsAsync();
            CloseReturnDialog();
        }
        else
        {
            _returnErrors = response.Errors;
        }

        _submittingReturn = false;
    }

    private async Task LoadOrderAsync()
    {
        var res = await OrderService.GetMyOrderByIdAsync(new OrderGetByIdRequest { Id = OrderId });
        _order = res.Data;
        if (_order == null)
            return;

        var shipmentTask = OrderService.GetMyShipmentByOrderIdAsync(new OrderShipmentGetByOrderIdRequest { OrderId = OrderId });
        var returnTask = OrderService.GetMyReturnListAsync(new MyReturnListRequest { PageNo = 1, PageSize = 20 });
        await Task.WhenAll(shipmentTask, returnTask);

        _order.Shipment = shipmentTask.Result.Data;
        _order.Returns = returnTask.Result.Data?.Items.Where(item => item.OrderId == OrderId).ToList() ?? new();
    }

    private async Task LoadReturnsAsync()
    {
        if (_order == null)
            return;

        var response = await OrderService.GetMyReturnListAsync(new MyReturnListRequest { PageNo = 1, PageSize = 20 });
        _order.Returns = response.Data?.Items.Where(item => item.OrderId == OrderId).ToList() ?? new();
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "Delivered" => Color.Success,
        "Shipped" => Color.Info,
        "Cancelled" => Color.Error,
        "Confirmed" => Color.Primary,
        _ => Color.Warning
    };
}
