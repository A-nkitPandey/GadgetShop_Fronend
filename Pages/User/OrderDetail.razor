@page "/account/orders/{OrderId:long}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderService
@inject ISnackbar Snackbar

<PageTitle>Order Details – GadgetShop</PageTitle>

@if (_loading)
{
    <MudSkeleton Height="500px" Class="rounded-xl" />
}
else if (_order == null)
{
    <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Order not found" ActionHref="/account/orders" ActionLabel="Back to Orders" />
}
else
{
    <div class="d-flex align-center gap-3 mb-6">
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Href="/account/orders" />
        <MudText Typo="Typo.h4" Class="gs-page-title">Order #@_order.OrderNo</MudText>
        <MudChip T="string" Color="@GetStatusColor(_order.Status)" Size="Size.Small">@_order.Status</MudChip>
    </div>

    <MudGrid>
        <!-- ORDER ITEMS -->
        <MudItem xs="12" md="8">
            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Items Ordered</MudText>
                    @foreach (var item in _order.Items)
                    {
                        <div class="d-flex align-center gap-3 py-2 gs-order-item-row">
                            <img src="@(item.ImageUrl ?? "https://via.placeholder.com/60")"
                                 alt="@item.ProductName" style="width:60px;height:60px;object-fit:cover;border-radius:8px;flex-shrink:0" />
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">@item.ProductName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Qty: @item.Quantity × ₹@item.UnitPrice.ToString("N0")</MudText>
                            </div>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">₹@item.TotalPrice.ToString("N0")</MudText>
                        </div>
                    }
                </MudCardContent>
            </MudCard>

            <!-- TRACKING -->
            @if (!string.IsNullOrWhiteSpace(_order.TrackingNo))
            {
                <MudCard Elevation="0" Class="gs-detail-card mb-4">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="fw-bold mb-2">Shipment Tracking</MudText>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Rounded.LocalShipping" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">Tracking No: <strong>@_order.TrackingNo</strong></MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>

        <!-- SUMMARY SIDEBAR -->
        <MudItem xs="12" md="4">
            <!-- ORDER SUMMARY -->
            <MudCard Elevation="0" Class="gs-detail-card mb-4">
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Order Summary</MudText>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Order Date</MudText><MudText Typo="Typo.body2">@_order.CreatedAt.ToString("dd MMM yyyy")</MudText></div>
                    <div class="gs-summary-row"><MudText Typo="Typo.body2">Payment Status</MudText><MudText Typo="Typo.body2">@(_order.PaymentStatus ?? "N/A")</MudText></div>
                    <MudDivider Class="my-2" />
                    <div class="gs-summary-row">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Total</MudText>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Primary">₹@_order.TotalAmount.ToString("N0")</MudText>
                    </div>
                </MudCardContent>
            </MudCard>

            <!-- DELIVERY ADDRESS -->
            @if (_order.DeliveryAddress != null)
            {
                <MudCard Elevation="0" Class="gs-detail-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="fw-bold mb-2">Delivery Address</MudText>
                        <MudText Typo="Typo.subtitle2">@_order.DeliveryAddress.FullName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_order.DeliveryAddress.AddressLine1<br />
                            @if (!string.IsNullOrWhiteSpace(_order.DeliveryAddress.AddressLine2))
                            { @(_order.DeliveryAddress.AddressLine2)<text><br /></text> }
                            @_order.DeliveryAddress.City, @_order.DeliveryAddress.State – @_order.DeliveryAddress.PinCode
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">📞 @_order.DeliveryAddress.PhoneNumber</MudText>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public long OrderId { get; set; }
    private bool _loading = true;
    private OrderDto? _order;

    protected override async Task OnInitializedAsync()
    {
        var res = await OrderService.GetMyOrderByIdAsync(new OrderGetByIdRequest { OrderId = OrderId });
        _order = res.Data;
        _loading = false;
    }

    private Color GetStatusColor(string? s) => s switch
    {
        "Delivered" => Color.Success, "Shipped" => Color.Info,
        "Cancelled" => Color.Error, "Confirmed" => Color.Primary, _ => Color.Warning
    };
}
