@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthState
@inject CartState CartState
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" IsDarkMode="@_isDarkMode" />
<MudSnackbarProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />

<AuthorizeView Roles="Admin,SuperAdmin">
    <Authorized>
        <AdminLayout>
            @Body
        </AdminLayout>
    </Authorized>
    <NotAuthorized>
        <PublicLayout CartCount="@CartState.ItemCount" OnToggleTheme="ToggleTheme" IsDarkMode="@_isDarkMode">
            @Body
        </PublicLayout>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _isDarkMode;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#7C3AED",
            PrimaryDarken = "#5B21B6",
            PrimaryLighten = "#A78BFA",
            Secondary = "#F59E0B",
            SecondaryDarken = "#D97706",
            Tertiary = "#06B6D4",
            Background = "#F8F7FF",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1F2937",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1F2937",
            TextPrimary = "#111827",
            TextSecondary = "#6B7280",
            ActionDefault = "#7C3AED",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#3B82F6",
            GrayLight = "#F3F4F6",
            GrayLighter = "#F9FAFB",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#8B5CF6",
            Secondary = "#F59E0B",
            Background = "#0F0F1A",
            Surface = "#1A1A2E",
            AppbarBackground = "#1A1A2E",
            DrawerBackground = "#16213E",
            TextPrimary = "#F9FAFB",
            TextSecondary = "#9CA3AF",
        },
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Inter", "system-ui", "sans-serif" }
                },
                H1 = new H1Typography { FontSize = "2.5rem", FontWeight = "700", LetterSpacing = "-0.025em" },
                H2 = new H2Typography { FontSize = "2rem", FontWeight = "700" },
                H3 = new H3Typography { FontSize = "1.5rem", FontWeight = "600" },
                H4 = new H4Typography { FontSize = "1.25rem", FontWeight = "600" },
                H5 = new H5Typography { FontSize = "1.125rem", FontWeight = "600" },
                H6 = new H6Typography { FontSize = "1rem", FontWeight = "600" },
            },
            LayoutProperties = new LayoutProperties
            {
                AppbarHeight = "68px",
                DrawerWidthLeft = "260px",
            }
    };

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;
}
