@inject AuthService AuthService
@inject CartState CartState
@inject WishlistState WishlistState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject UserAccountService UserAccountService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="gs-public-layout">
    <MudAppBar Fixed="true" Elevation="1" Class="gs-appbar" Color="Color.Surface">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gs-appbar-shell">
            <div class="gs-brand-group">
                <MudIconButton Icon="@Icons.Material.Rounded.ElectricBolt"
                               Color="Color.Primary"
                               Size="Size.Large"
                               Href="/"
                               Class="gs-logo-btn" />
                <a href="/" class="gs-logo-text">
                    <MudText Typo="Typo.h6">
                        <span style="color:var(--mud-palette-primary)">Gadget</span>Shop
                    </MudText>
                </a>
            </div>

            <div class="gs-search-wrap">
                <MudTextField @bind-Value="_searchText"
                              Placeholder="Search gadgets, brands, categories..."
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Rounded.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="gs-search"
                              OnKeyDown="OnSearchKeyDown" />
            </div>

            <div class="gs-header-actions">
                <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="@(() => OnToggleTheme.InvokeAsync())" />

                <AuthorizeView>
                    <Authorized>
                        @if (ShowNotificationBadge)
                        {
                            <MudBadge Content="@_unreadNotificationCount" Color="Color.Info" Overlap="true" Class="mr-1">
                                <MudIconButton Icon="@Icons.Material.Rounded.NotificationsNone" Color="Color.Inherit" Href="/account/notifications" />
                            </MudBadge>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.NotificationsNone" Color="Color.Inherit" Href="/account/notifications" />
                        }

                        @if (ShowWishlistBadge)
                        {
                            <MudBadge Content="@CurrentWishlistCount" Color="Color.Secondary" Overlap="true" Class="mr-1">
                                <MudIconButton Icon="@Icons.Material.Rounded.FavoriteBorder" Color="Color.Inherit" Href="/wishlist" />
                            </MudBadge>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.FavoriteBorder" Color="Color.Inherit" Href="/wishlist" />
                        }

                        @if (ShowCartBadge)
                        {
                            <MudBadge Content="@CurrentCartCount" Color="Color.Primary" Overlap="true" Class="mr-1">
                                <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Inherit" Href="/cart" />
                            </MudBadge>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Inherit" Href="/cart" Class="mr-1" />
                        }
                        <MudMenu Icon="@Icons.Material.Rounded.AccountCircle" Color="Color.Inherit">
                            <MudMenuItem Href="/account/profile">My Profile</MudMenuItem>
                            <MudMenuItem Href="/account/orders">My Orders</MudMenuItem>
                            <MudMenuItem Href="/account/support-tickets">Support Tickets</MudMenuItem>
                            <MudMenuItem Href="/account/wishlist">Wishlist</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem OnClick="LogoutAsync">Logout</MudMenuItem>
                        </MudMenu>
                    </Authorized>
                    <NotAuthorized>
                        @if (ShowCartBadge)
                        {
                            <MudBadge Content="@CurrentCartCount" Color="Color.Primary" Overlap="true" Class="mr-1">
                                <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Inherit" Href="/cart" />
                            </MudBadge>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Inherit" Href="/cart" Class="mr-1" />
                        }

                        <div class="gs-auth-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/login">Sign In</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/register">Sign Up</MudButton>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </MudContainer>
    </MudAppBar>

    <div class="gs-category-bar">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            <div class="gs-category-bar-shell">
                <MudText Typo="Typo.caption" Class="gs-category-label">Browse</MudText>
                <div class="gs-category-nav">
                    <MudButton StartIcon="@Icons.Material.Rounded.GridView" Href="/catalog">All Products</MudButton>
                    <MudButton StartIcon="@Icons.Material.Rounded.PhoneAndroid" Href="/catalog?q=Smartphones">Smartphones</MudButton>
                    <MudButton StartIcon="@Icons.Material.Rounded.LaptopMac" Href="/catalog?q=Laptops">Laptops</MudButton>
                    <MudButton StartIcon="@Icons.Material.Rounded.Headphones" Href="/catalog?q=Audio">Audio</MudButton>
                    <MudButton StartIcon="@Icons.Material.Rounded.Watch" Href="/catalog?q=Wearables">Wearables</MudButton>
                    <MudButton StartIcon="@Icons.Material.Rounded.Camera" Href="/catalog?q=Cameras">Cameras</MudButton>
                    <MudButton StartIcon="@Icons.Material.Rounded.LocalOffer" Color="Color.Secondary" Href="/catalog?q=Deals">Deals</MudButton>
                </div>
            </div>
        </MudContainer>
    </div>

    <main class="gs-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 gs-page-shell">
            @ChildContent
        </MudContainer>
    </main>

    <AuthorizeView>
        <Authorized>
            <footer class="gs-footer">
                <MudContainer MaxWidth="MaxWidth.ExtraLarge">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.h5" Class="mb-3 fw-bold">
                                <span style="color:var(--mud-palette-primary)">Gadget</span>Shop
                            </MudText>
                            <MudText Typo="Typo.body2" Class="gs-footer-text">
                                Premium electronics and gadgets delivered to your door. Quality guaranteed.
                            </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Shop</MudText>
                            <MudLink Href="/catalog" Class="gs-footer-link gs-footer-link-block mb-1">All Products</MudLink>
                            <MudLink Href="/catalog?q=Smartphones" Class="gs-footer-link gs-footer-link-block mb-1">Smartphones</MudLink>
                            <MudLink Href="/catalog?q=Laptops" Class="gs-footer-link gs-footer-link-block mb-1">Laptops</MudLink>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Account</MudText>
                            <MudLink Href="/account/profile" Class="gs-footer-link gs-footer-link-block mb-1">My Profile</MudLink>
                            <MudLink Href="/account/orders" Class="gs-footer-link gs-footer-link-block mb-1">My Orders</MudLink>
                            <MudLink Href="/wishlist" Class="gs-footer-link gs-footer-link-block mb-1">Wishlist</MudLink>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Support</MudText>
                            <MudText Typo="Typo.body2" Class="gs-footer-text">support@gadgetshop.com</MudText>
                            <MudText Typo="Typo.body2" Class="gs-footer-text">Mon-Sat, 9am-6pm</MudText>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.caption" Class="text-center gs-footer-text">
                        &copy; @DateTime.Now.Year GadgetShop. All rights reserved.
                    </MudText>
                </MudContainer>
            </footer>
        </Authorized>
    </AuthorizeView>

    <div class="gs-mobile-nav">
        <MudIconButton Icon="@Icons.Material.Rounded.Home" Href="/" />
        <MudIconButton Icon="@Icons.Material.Rounded.Search" Href="/catalog" />
        @if (ShowCartBadge)
        {
            <MudBadge Content="@CurrentCartCount" Color="Color.Primary" Overlap="true">
                <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Href="/cart" />
            </MudBadge>
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Href="/cart" />
        }
        <AuthorizeView>
            <Authorized>
                @if (ShowNotificationBadge)
                {
                    <MudBadge Content="@_unreadNotificationCount" Color="Color.Info" Overlap="true">
                        <MudIconButton Icon="@Icons.Material.Rounded.NotificationsNone" Href="/account/notifications" />
                    </MudBadge>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Rounded.NotificationsNone" Href="/account/notifications" />
                }
                <MudIconButton Icon="@Icons.Material.Rounded.Person" Href="/account/profile" />
            </Authorized>
            <NotAuthorized>
                <MudIconButton Icon="@Icons.Material.Rounded.Person" Href="/login" />
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int CartCount { get; set; }
    [Parameter] public int WishlistCount { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }
    [Parameter] public bool IsDarkMode { get; set; }

    private string _searchText = string.Empty;
    private int _unreadNotificationCount;
    private int CurrentCartCount => CartState.ItemCount > 0 ? CartState.ItemCount : CartCount;
    private int CurrentWishlistCount => WishlistState.ItemCount > 0 ? WishlistState.ItemCount : WishlistCount;
    private bool ShowCartBadge => CartState.IsInitialized && CurrentCartCount > 0;
    private bool ShowWishlistBadge => WishlistState.IsInitialized && CurrentWishlistCount > 0;
    private bool ShowNotificationBadge => _unreadNotificationCount > 0;

    protected override void OnInitialized()
    {
        CartState.OnChange += HandleStateChanged;
        WishlistState.OnChange += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await LoadNotificationCountAsync();
        }
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchText))
        {
            Nav.NavigateTo($"/catalog?q={Uri.EscapeDataString(_searchText)}");
        }
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        _unreadNotificationCount = 0;
        Nav.NavigateTo("/");
        Snackbar.Add("Logged out successfully", Severity.Success);
    }

    private async Task LoadNotificationCountAsync()
    {
        var response = await UserAccountService.GetMyNotificationsAsync();
        if (response.IsSuccess && response.Data != null)
        {
            _unreadNotificationCount = response.Data.Count(x => !x.IsRead);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartState.OnChange -= HandleStateChanged;
        WishlistState.OnChange -= HandleStateChanged;
    }
}
