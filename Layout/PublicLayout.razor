@inject AuthenticationStateProvider AuthStateProvider
@inject AuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="gs-public-layout">
    <!-- TOP HEADER -->
    <MudAppBar Fixed="true" Elevation="1" Class="gs-appbar" Color="Color.Surface">
        <MudIconButton Icon="@Icons.Material.Rounded.ElectricBolt" Color="Color.Primary" Size="Size.Large"
                       Href="/" Class="gs-logo-btn" />
        <MudText Typo="Typo.h6" Class="gs-logo-text" Href="/">
            <span style="color:var(--mud-palette-primary)">Gadget</span>Shop
        </MudText>

        <MudSpacer />

        <!-- SEARCH BAR -->
        <div class="gs-search-wrap">
            <MudTextField @bind-Value="_searchText"
                          Placeholder="Search gadgets, brands, categories..."
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="gs-search"
                          OnKeyDown="OnSearchKeyDown" />
        </div>

        <MudSpacer />

        <!-- DARK MODE -->
        <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                       Color="Color.Inherit" OnClick="@(() => OnToggleTheme.InvokeAsync())" />

        <!-- WISHLIST -->
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Rounded.FavoriteBorder" Color="Color.Inherit" Href="/wishlist" />
                <MudBadge Content="@CartCount" Color="Color.Primary" Overlap="true" Class="mr-1">
                    <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Inherit" Href="/cart" />
                </MudBadge>
                <MudMenu Icon="@Icons.Material.Rounded.AccountCircle" Color="Color.Inherit">
                    <MudMenuItem Href="/account/profile">My Profile</MudMenuItem>
                    <MudMenuItem Href="/account/orders">My Orders</MudMenuItem>
                    <MudMenuItem Href="/account/wishlist">Wishlist</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="LogoutAsync">Logout</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudBadge Content="@CartCount" Color="Color.Primary" Overlap="true" Class="mr-1">
                    <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Color="Color.Inherit" Href="/cart" />
                </MudBadge>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/login" Class="ml-2">Sign In</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/register" Class="ml-2">Sign Up</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <!-- CATEGORY NAV BAR -->
    <div class="gs-category-bar">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            <div class="gs-category-nav">
                <MudButton StartIcon="@Icons.Material.Rounded.GridView" Href="/catalog">All Products</MudButton>
                <MudButton StartIcon="@Icons.Material.Rounded.PhoneAndroid" Href="/catalog?cat=smartphones">Smartphones</MudButton>
                <MudButton StartIcon="@Icons.Material.Rounded.LaptopMac" Href="/catalog?cat=laptops">Laptops</MudButton>
                <MudButton StartIcon="@Icons.Material.Rounded.Headphones" Href="/catalog?cat=audio">Audio</MudButton>
                <MudButton StartIcon="@Icons.Material.Rounded.Watch" Href="/catalog?cat=wearables">Wearables</MudButton>
                <MudButton StartIcon="@Icons.Material.Rounded.Camera" Href="/catalog?cat=cameras">Cameras</MudButton>
                <MudButton StartIcon="@Icons.Material.Rounded.LocalOffer" Color="Color.Secondary">Deals</MudButton>
            </div>
        </MudContainer>
    </div>

    <!-- MAIN CONTENT -->
    <main class="gs-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @ChildContent
        </MudContainer>
    </main>

    <!-- FOOTER -->
    <footer class="gs-footer">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.h5" Class="mb-3 fw-bold">
                        <span style="color:var(--mud-palette-primary)">Gadget</span>Shop
                    </MudText>
                    <MudText Typo="Typo.body2" Class="gs-footer-text">
                        Premium electronics and gadgets delivered to your door. Quality guaranteed.
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Shop</MudText>
                    <MudLink Href="/catalog" Class="gs-footer-link d-block mb-1">All Products</MudLink>
                    <MudLink Href="/catalog?cat=smartphones" Class="gs-footer-link d-block mb-1">Smartphones</MudLink>
                    <MudLink Href="/catalog?cat=laptops" Class="gs-footer-link d-block mb-1">Laptops</MudLink>
                </MudItem>
                <MudItem xs="6" sm="2">
                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Account</MudText>
                    <MudLink Href="/account/profile" Class="gs-footer-link d-block mb-1">My Profile</MudLink>
                    <MudLink Href="/account/orders" Class="gs-footer-link d-block mb-1">My Orders</MudLink>
                    <MudLink Href="/wishlist" Class="gs-footer-link d-block mb-1">Wishlist</MudLink>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.subtitle2" Class="mb-2 fw-bold">Support</MudText>
                    <MudText Typo="Typo.body2" Class="gs-footer-text">support@gadgetshop.com</MudText>
                    <MudText Typo="Typo.body2" Class="gs-footer-text">Mon–Sat, 9am–6pm</MudText>
                </MudItem>
            </MudGrid>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Class="text-center gs-footer-text">
                © @DateTime.Now.Year GadgetShop. All rights reserved.
            </MudText>
        </MudContainer>
    </footer>

    <!-- MOBILE BOTTOM NAV -->
    <div class="gs-mobile-nav d-md-none">
        <MudIconButton Icon="@Icons.Material.Rounded.Home" Href="/" />
        <MudIconButton Icon="@Icons.Material.Rounded.Search" Href="/catalog" />
        <MudBadge Content="@CartCount" Color="Color.Primary" Overlap="true">
            <MudIconButton Icon="@Icons.Material.Rounded.ShoppingCart" Href="/cart" />
        </MudBadge>
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Rounded.Person" Href="/account/profile" />
            </Authorized>
            <NotAuthorized>
                <MudIconButton Icon="@Icons.Material.Rounded.Person" Href="/login" />
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int CartCount { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }
    [Parameter] public bool IsDarkMode { get; set; }

    private string _searchText = string.Empty;

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchText))
            Nav.NavigateTo($"/catalog?q={Uri.EscapeDataString(_searchText)}");
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/");
        Snackbar.Add("Logged out successfully", Severity.Success);
    }
}
