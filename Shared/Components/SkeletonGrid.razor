@* File: Shared/Components/SkeletonGrid.razor *@
<MudGrid>
    @for (int i = 0; i < Count; i++)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Elevation="0" Class="gs-product-card">
                <MudSkeleton Height="220px" Class="rounded-lg" />
                <MudCardContent>
                    <MudSkeleton Width="60%" Height="14px" Class="mb-2" />
                    <MudSkeleton Width="90%" Height="18px" Class="mb-2" />
                    <MudSkeleton Width="40%" Height="24px" />
                </MudCardContent>
                <MudCardActions>
                    <MudSkeleton Width="100%" Height="40px" Class="rounded-lg" />
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter] public int Count { get; set; } = 8;
}
