@* File: Shared/Components/EmptyState.razor *@
<div class="gs-empty-state">
    <MudIcon Icon="@Icon" Class="gs-empty-icon" Style="font-size:5rem;opacity:0.3" />
    <MudText Typo="Typo.h6" Class="mt-3">@Title</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Subtitle</MudText>
    @if (!string.IsNullOrWhiteSpace(ActionHref))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ActionHref" Class="mt-4">@ActionLabel</MudButton>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Rounded.Inbox;
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public string ActionLabel { get; set; } = "Go";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
