@inject AuthenticationStateProvider AuthStateProvider
@inject CartService CartService
@inject CartState CartState
@inject AuthState AuthState

@* Invisible component mounted in MainLayout to bootstrap state *@

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user  = state.User;

        if (user.Identity?.IsAuthenticated != true) return;

        // Populate AuthState
        var roles = user.Claims
            .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role")
            .Select(c => c.Value)
            .ToList();

        var name = user.Identity.Name
                   ?? user.FindFirst("name")?.Value
                   ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

        AuthState.SetUser(name, roles);

        // Skip cart load for admin users
        if (roles.Contains("Admin") || roles.Contains("SuperAdmin")) return;

        var cart = await CartService.GetMyCartAsync();
        if (cart.IsSuccess) CartState.SetCart(cart.Data);
    }
}
