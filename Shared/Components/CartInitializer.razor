@inject AuthenticationStateProvider AuthStateProvider
@inject CartService CartService
@inject WishlistService WishlistService
@inject CartState CartState
@inject WishlistState WishlistState
@inject NotificationState NotificationState
@inject AuthState AuthState
@inject ILogger<CartInitializer> Logger
@* Invisible component mounted in MainLayout to bootstrap state *@

@code {
    private bool _bootstrapped;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _bootstrapped)
        {
            return;
        }

        _bootstrapped = true;
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                AuthState.Clear();
                CartState.Clear();
                WishlistState.Clear();
                NotificationState.Reset();
                return;
            }

            var roles = user.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role")
                .Select(c => c.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var name = user.Identity.Name
                       ?? user.FindFirst("name")?.Value
                       ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

            AuthState.SetUser(name, roles);

            if (GadgetShop.Constants.AppRoles.IsAdmin(roles))
            {
                CartState.Clear();
                WishlistState.Clear();
                return;
            }

            var cartTask = CartState.IsInitialized ? Task.FromResult<ApiResponse<CartDto>?>(null) : CartService.GetMyCartAsync();
            var wishlistTask = WishlistState.IsInitialized ? Task.FromResult<ApiResponse<List<WishlistItemDto>>?>(null) : WishlistService.GetMyWishlistAsync();
            await Task.WhenAll(cartTask, wishlistTask);

            var cart = await cartTask;
            var wishlist = await wishlistTask;
            if (cart?.IsSuccess == true)
                CartState.SetCart(cart.Data);
            if (wishlist?.IsSuccess == true)
                WishlistState.SetCount(wishlist.Data?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Cart initialization failed; continuing app render.");
            CartState.Clear();
            WishlistState.Clear();
        }
    }
}
