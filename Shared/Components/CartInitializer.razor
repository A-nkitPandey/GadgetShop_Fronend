@inject AuthenticationStateProvider AuthStateProvider
@inject CartService CartService
@inject WishlistService WishlistService
@inject CartState CartState
@inject WishlistState WishlistState
@inject AuthState AuthState
@inject ILogger<CartInitializer> Logger

@* Invisible component mounted in MainLayout to bootstrap state *@

@code {
    protected override async Task OnInitializedAsync()
    {
        CartState.Reset();
        WishlistState.Reset();

        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                AuthState.Clear();
                CartState.Clear();
                WishlistState.Clear();
                return;
            }

            var roles = user.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role")
                .Select(c => c.Value)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var name = user.Identity.Name
                       ?? user.FindFirst("name")?.Value
                       ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

            AuthState.SetUser(name, roles);

            if (GadgetShop.Constants.AppRoles.IsAdmin(roles))
            {
                CartState.Clear();
                WishlistState.Clear();
                return;
            }

            var cart = await CartService.GetMyCartAsync();
            var wishlist = await WishlistService.GetMyWishlistAsync();
            if (cart.IsSuccess)
                CartState.SetCart(cart.Data);
            if (wishlist.IsSuccess)
                WishlistState.SetCount(wishlist.Data?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Cart initialization failed; continuing app render.");
            CartState.Clear();
            WishlistState.Clear();
        }
    }
}
