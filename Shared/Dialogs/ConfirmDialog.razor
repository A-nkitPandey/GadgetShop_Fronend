@* File: Shared/Dialogs/ConfirmDialog.razor *@

<MudDialog>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        @if (ShowCancel)
        {
            <MudButton OnClick="Cancel">@CancelLabel</MudButton>
        }
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">@ConfirmLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmLabel { get; set; } = "OK";
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public bool ShowCancel { get; set; } = true;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
